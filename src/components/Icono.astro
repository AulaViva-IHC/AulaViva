---
// Iconos de trazo (24×24). Solo los que ayudan a decidir; siempre van con texto
// (o con aria-label en el control que los contiene).
export type NombreIcono =
  | 'info' | 'alerta' | 'reloj' | 'check' | 'ojo' | 'ojo-cerrado'
  | 'sin-conexion' | 'reintentar' | 'salir' | 'flecha-izq' | 'flecha-der' | 'candado'
  | 'casa' | 'libro' | 'cuadricula' | 'medalla' | 'escudo' | 'campana' | 'buscar'
  | 'historial' | 'play' | 'subir' | 'mas' | 'chevron' | 'arrastre' | 'guardar'
  | 'codigo' | 'pluma' | 'grafico' | 'chat' | 'usuarios' | 'menu' | 'cerrar'
  | 'red' | 'chispa' | 'subtitulos' | 'nivel' | 'usuario-mas' | 'pantalla' | 'portapapeles' | 'lapiz'
  | 'descargar' | 'enlace' | 'enviar' | 'estrella' | 'escanear' | 'circulo' | 'punto'
  | 'deshacer' | 'sonido' | 'silencio';

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 20, class: clase } = Astro.props;

const punto = (x: number, y: number) => `<circle cx="${x}" cy="${y}" r="1.2" fill="currentColor" stroke="none"/>`;

const trazos: Record<NombreIcono, string> = {
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  alerta: '<path d="M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 16.5h.01"/>',
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  ojo: '<path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"/><circle cx="12" cy="12" r="3"/>',
  'ojo-cerrado': '<path d="M3 3l18 18"/><path d="M10.6 5.1A9.6 9.6 0 0 1 12 5c6 0 9.5 7 9.5 7a16 16 0 0 1-2.9 3.8M6.6 6.6A16 16 0 0 0 2.5 12S6 19 12 19a9.4 9.4 0 0 0 4.4-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>',
  'sin-conexion': '<path d="M3 3l18 18"/><path d="M8.5 16.4a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 4.2-2.6M14.8 10.3A10 10 0 0 1 19 12.9M1.5 9.3a15 15 0 0 1 4.3-2.8M10.6 5.1A15 15 0 0 1 22.5 9.3"/><path d="M12 20h.01"/>',
  reintentar: '<path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5"/>',
  salir: '<path d="M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M9 16l-4-4 4-4M5 12h11"/>',
  'flecha-izq': '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  'flecha-der': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  candado: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  casa: '<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9v11h5v-6h3v6h5V9"/>',
  libro: '<path d="M6 3.5h12v17H7.5A1.5 1.5 0 0 1 6 19V3.5Z"/><path d="M6 17h12"/>',
  cuadricula: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/>',
  medalla: '<circle cx="12" cy="9" r="5.5"/><path d="M9 14 8 21l4-2.2 4 2.2-1-7"/>',
  escudo: '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
