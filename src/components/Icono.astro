  buscar: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>',
  historial: '<path d="M3 12a9 9 0 1 0 2.6-6.4L3 8"/><path d="M3 3v5h5"/><path d="M12 8v4l3 2"/>',
  play: '<path d="M8 5.5v13l10-6.5-10-6.5Z" fill="currentColor"/>',
  subir: '<path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  arrastre: [punto(9, 6), punto(15, 6), punto(9, 12), punto(15, 12), punto(9, 18), punto(15, 18)].join(''),
  guardar: '<path d="M5 4h11l3 3v13H5V4Z"/><path d="M8 4v5h7V4M8 20v-6h8v6"/>',
  codigo: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5"/>',
