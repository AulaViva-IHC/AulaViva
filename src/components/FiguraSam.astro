---
// Act. 20 · Figura propia de la escala SAM (Self-Assessment Manikin), dibujada con SVG simple.
// 5 niveles por dimensión (las posiciones 1, 3, 5, 7 y 9 de la escala):
//   valencia   → la boca va de ceño fruncido (1) a sonrisa (5)
//   activacion → de ojos cerrados (1) a ojos muy abiertos con una explosión en el pecho que crece (5)
//   control    → la figura va de pequeña (1) a grande (5)
// Es decorativa para el lector de pantalla (aria-hidden): el texto lo da el radio ("5 de 9, neutral").
import type { DimensionSam } from '../lib/sam';

interface Props {
  dimension: DimensionSam;
  nivel: 1 | 2 | 3 | 4 | 5;
}
const { dimension, nivel } = Astro.props;

/** Estrella de `puntas` picos centrada en (cx, cy). */
function estrella(cx: number, cy: number, rExt: number, rInt: number, puntas = 8): string {
  return Array.from({ length: puntas * 2 }, (_, i) => {
    const r = i % 2 ? rInt : rExt;
    const a = (Math.PI * i) / puntas - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
}

// Boca: curva cuadrática; el punto de control arriba = ceño (∩), abajo = sonrisa (∪).
const curva = dimension === 'valencia' ? (nivel - 3) * 3.5 : 0;
const boca = `M18 23 Q24 ${23 + curva} 30 23`;
// Activación: ojos cerrados en el nivel 1; luego más grandes. Explosión desde el nivel 2.
const ojosCerrados = dimension === 'activacion' && nivel === 1;
const radioOjo = dimension === 'activacion' ? 1.2 + (nivel - 1) * 0.45 : 1.6;
const explosion = dimension === 'activacion' && nivel > 1 ? estrella(24, 45, 3 + (nivel - 1) * 3, 1.5 + (nivel - 1) * 1.2) : null;
// Control: escala desde los pies (abajo al centro).
const escala = dimension === 'control' ? 0.5 + (nivel - 1) * 0.125 : 1;
const transformar = escala === 1 ? undefined : `translate(24 63) scale(${escala}) translate(-24 -63)`;
---

<svg class="figura-sam" viewBox="0 0 48 64" width="48" height="64" aria-hidden="true" focusable="false">
  <g transform={transformar} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <!-- Cuerpo -->
    <path d="M10 62 C10 44 14 33 24 33 C34 33 38 44 38 62 Z" fill="var(--figura-relleno, transparent)" />
    <!-- Cabeza -->
    <circle cx="24" cy="18" r="12" fill="var(--white)" />
    <!-- Ojos -->
    {
      ojosCerrados ? (
        <>
          <path d="M17.5 15.5 Q19.5 17.5 21.5 15.5" />
          <path d="M26.5 15.5 Q28.5 17.5 30.5 15.5" />
        </>
      ) : (
        <>
          <circle cx="19.5" cy="15" r={radioOjo} fill="currentColor" stroke="none" />
          <circle cx="28.5" cy="15" r={radioOjo} fill="currentColor" stroke="none" />
        </>
      )
    }
    <!-- Cejas fruncidas solo en la valencia más baja -->
    {dimension === 'valencia' && nivel === 1 && (
      <>
        <path d="M16.5 10.5 L21.5 12" />
        <path d="M31.5 10.5 L26.5 12" />
      </>
    )}
    <!-- Boca (en la activación más alta, abierta) -->
    {dimension === 'activacion' && nivel === 5 ? <ellipse cx="24" cy="23.5" rx="2.6" ry="2.2" /> : <path d={boca} />}
    <!-- Explosión en el pecho -->
    {explosion && <polygon points={explosion} fill="currentColor" stroke="none" />}
  </g>
</svg>

<style>
  .figura-sam {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
</style>
