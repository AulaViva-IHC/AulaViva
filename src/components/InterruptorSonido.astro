---
// Interruptor "Sonido y vibración" (WCAG 1.4.2 Control del audio).
// <button aria-pressed>: el nombre accesible es "Sonido y vibración" y el estado lo da
// aria-pressed; el texto visible "activado/desactivado" repite el estado para quien ve.
// La preferencia se guarda en localStorage (aulaviva:sonido) y vale para todas las páginas
// y pestañas. tono "oscuro" para el panel índigo del login y el registro.
import Icono from './Icono.astro';

interface Props {
  tono?: 'claro' | 'oscuro';
  class?: string;
}
const { tono = 'claro', class: clase } = Astro.props;
---

<button
  type="button"
  class:list={['interruptor', `interruptor--${tono}`, clase]}
  aria-pressed="true"
  data-interruptor-sonido
>
  <span class="interruptor__icono interruptor__icono--si"><Icono nombre="sonido" tamano={20} /></span>
  <span class="interruptor__icono interruptor__icono--no"><Icono nombre="silencio" tamano={20} /></span>
  <span class="interruptor__texto">Sonido y vibración<span aria-hidden="true">: <span data-interruptor-estado>activado</span></span></span>
</button>

<script>
  import { cambiarSonido, sonidoActivo, CLAVE_SONIDO } from '../scripts/multimodal';

  function pintar(activo: boolean): void {
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-interruptor-sonido]')) {
      b.setAttribute('aria-pressed', String(activo));
      b.querySelector('[data-interruptor-estado]')!.textContent = activo ? 'activado' : 'desactivado';
    }
  }

  pintar(sonidoActivo());
  document.addEventListener('click', (e) => {
    const boton = (e.target as Element).closest('[data-interruptor-sonido]');
    if (!boton) return;
    const activo = boton.getAttribute('aria-pressed') !== 'true';
    pintar(activo);
    cambiarSonido(activo);
  });
  // Cambiado en otra pestaña o en un iframe de /estados.
  window.addEventListener('storage', (e) => {
    if (e.key === CLAVE_SONIDO) pintar(sonidoActivo());
  });
</script>

<style>
  .interruptor {
    display: inline-flex;
    align-items: center;
    gap: var(--e2);
    min-height: var(--alto-control);
    padding: 0 var(--e3);
    border: 0;
    border-radius: var(--radio-control);
    font: inherit;
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
    white-space: nowrap;
    flex: none;
    cursor: pointer;
    transition:
      transform var(--t-rapido) ease-out,
      background-color 120ms ease-out;
  }
  .interruptor:hover {
    transform: scale(1.02);
  }
  .interruptor:active {
    transform: scale(0.97);
    transition-duration: 40ms;
  }
  .interruptor--claro {
    background: var(--white);
    color: var(--ink);
  }
  .interruptor--claro[aria-pressed='true'] .interruptor__icono {
    color: var(--indigo3);
  }
  .interruptor--oscuro {
    background: var(--indigo2);
    color: var(--white);
  }
  .interruptor__icono {
    display: inline-flex;
  }
  .interruptor[aria-pressed='true'] .interruptor__icono--no,
  .interruptor[aria-pressed='false'] .interruptor__icono--si {
    display: none;
  }
  .interruptor[aria-pressed='false'] {
    color: var(--ink2);
  }
  .interruptor--oscuro[aria-pressed='false'] {
    color: rgb(255 255 255 / 0.85);
  }
  @media (max-width: 479px) {
    .interruptor {
      padding: 0 12px;
    }
  }
</style>
