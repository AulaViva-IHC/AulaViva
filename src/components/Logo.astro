---
// Logo de AulaViva: cuadro amarillo con la "A" y el nombre.
interface Props {
  /** 'claro' para fondos oscuros (texto blanco), 'oscuro' para fondos claros. */
  tono?: 'claro' | 'oscuro';
  href?: string;
}
const { tono = 'oscuro', href = '/' } = Astro.props;
---

<a class:list={['logo', `logo--${tono}`]} href={href} aria-label="AulaViva, ir al inicio">
  <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="8" fill="#FFD23F"></rect>
    <path d="M12 30 20 10l8 20" fill="none" stroke="#17153B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="20" cy="23" r="2.6" fill="#17153B"></circle>
  </svg>
  <span>AulaViva</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.625rem;
    line-height: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo--claro {
    color: var(--white);
  }
  .logo--oscuro {
    color: var(--ink);
  }
</style>
