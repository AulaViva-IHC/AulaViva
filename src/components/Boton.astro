---
// Botón con el bucle perceptual completo (CLAUDE.md §5.4).
// Una variante por función: "principal" (amarillo, una por pantalla) o "secundario" (menta).
// Estados (atributo data-estado): normal · cargando · exito · error. Se cambian con
// ponerEstado() de src/scripts/boton.ts.
// Con `auto`, el botón de un <form> normal pasa solo a "cargando" al enviarse
// y bloquea un segundo envío. Con `href` es un enlace: al pulsarlo muestra
// "Abriendo…" mientras carga la página siguiente.
import type { HTMLAttributes } from 'astro/types';
import Icono from './Icono.astro';

type Props = {
  variante?: 'principal' | 'secundario';
  tipo?: 'button' | 'submit';
  href?: string;
  bloque?: boolean;
  auto?: boolean;
  textoCargando?: string;
  textoExito?: string;
} & Omit<HTMLAttributes<'button'>, 'type'>;

const {
  variante = 'principal',
  tipo = 'button',
  href,
  bloque = false,
  auto = false,
  textoCargando = href ? 'Abriendo…' : 'Guardando…',
  textoExito = '¡Listo!',
  class: clase,
  ...resto
} = Astro.props;

const clases = ['boton', `boton--${variante}`, bloque && 'boton--bloque', clase];
---

{
  href ? (
    <a href={href} class:list={clases} data-estado="normal" data-boton-enlace {...(resto as Record<string, unknown>)}>
      <span class="boton__capa boton__contenido">
        <slot />
      </span>
      <span class="boton__capa boton__cargando" aria-hidden="true">
        <span class="girador" />
        <span data-texto-cargando>{textoCargando}</span>
      </span>
      <span class="boton__barra" aria-hidden="true" />
    </a>
  ) : (
    <button
      type={tipo}
      class:list={clases}
      data-boton
      data-auto={auto ? '' : undefined}
      data-estado="normal"
      {...resto}
    >
      <span class="boton__capa boton__contenido">
        <slot />
      </span>
      <span class="boton__capa boton__cargando" aria-hidden="true">
        <span class="girador" />
        <span data-texto-cargando>{textoCargando}</span>
      </span>
      <span class="boton__capa boton__exito" aria-hidden="true">
        <Icono nombre="check" tamano={20} />
        <span data-texto-exito>{textoExito}</span>
      </span>
      <span class="boton__barra" aria-hidden="true" />
    </button>
  )
}

<script>
  import { ponerEstado, estaOcupado } from '../scripts/boton';

  // Formularios normales (sin JS propio): estado "cargando" y sin doble envío.
  document.addEventListener('submit', (evento) => {
    const form = evento.target as HTMLFormElement;
    const boton = form.querySelector<HTMLButtonElement>('[data-boton][data-auto]');
    if (!boton) return;
    if (estaOcupado(boton)) {
      evento.preventDefault();
      return;
    }
    ponerEstado(boton, 'cargando');
  });

  // Enlaces con forma de botón: "Abriendo…" mientras llega la página siguiente.
  document.addEventListener('click', (evento) => {
    const enlace = (evento.target as Element).closest<HTMLAnchorElement>('a[data-boton-enlace]');
    if (!enlace || evento.defaultPrevented) return;
    if (evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) return;
    if (enlace.target && enlace.target !== '_self') return;
    if (estaOcupado(enlace)) {
      evento.preventDefault();
      return;
    }
    ponerEstado(enlace, 'cargando');
  });
  // Al volver con "Atrás" la página sale de la caché: el botón vuelve a la normalidad.
  window.addEventListener('pageshow', (evento) => {
    if (!evento.persisted) return;
    for (const b of document.querySelectorAll<HTMLElement>('[data-boton-enlace], [data-boton][data-auto]')) {
      ponerEstado(b, 'normal');
    }
  });
</script>

<style>
  .boton {
    position: relative;
    display: inline-grid;
    grid-template-areas: 'capa';
    place-items: center;
    min-height: var(--alto-control);
    padding: 0 var(--e4);
    border: 0;
    border-radius: var(--radio-control);
    font-size: var(--t-cuerpo);
    line-height: var(--lh-cuerpo);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow: var(--sombra-1);
    transition:
      transform var(--t-rapido) ease-out,
      box-shadow 120ms ease-out,
      background-color 120ms ease-out,
      color 120ms ease-out;
  }
  .boton:hover {
    text-decoration: none;
  }
  .boton--bloque {
    display: grid;
    width: 100%;
  }

  .boton--principal { background: var(--yellow); }
  .boton--secundario { background: var(--mint); }

  /* Capas superpuestas: el ancho no salta al cambiar de estado */
  .boton__capa {
    grid-area: capa;
    display: inline-flex;
    align-items: center;
    gap: var(--e2);
  }
  .boton__cargando,
  .boton__exito {
    visibility: hidden;
  }

  /* 0 ms · hover: crece 2 % y sube la sombra */
  .boton[data-estado='normal']:not(:disabled, [aria-disabled='true']):hover {
    transform: scale(1.02);
    box-shadow: var(--sombra-2);
  }
  /* < 50 ms · clic: se hunde a 97 % y oscurece */
  .boton[data-estado='normal']:not(:disabled, [aria-disabled='true']):active {
    transform: scale(0.97);
    box-shadow: var(--sombra-1);
    transition-duration: 40ms;
  }
  .boton--principal[data-estado='normal']:active { background: var(--yellow-d); }
  .boton--secundario[data-estado='normal']:active { background: var(--mint-d); }

  /* 50 ms · procesando: giro + micro barra */
  .boton[data-estado='cargando'] {
    cursor: progress;
  }
  .boton[data-estado='cargando'] .boton__contenido,
  .boton[data-estado='exito'] .boton__contenido {
    visibility: hidden;
  }
  .boton[data-estado='cargando'] .boton__cargando {
    visibility: visible;
  }
  .boton__barra {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    background: rgb(23 21 59 / 0.45);
    transform: scaleX(0);
    transform-origin: left;
  }
  .boton[data-estado='cargando'] .boton__barra {
    animation: micro-barra 1.6s ease-out forwards;
  }

  /* 200 ms · listo: verde con check */
  .boton[data-estado='exito'] {
    background: var(--grn-t);
    color: var(--grn);
    cursor: default;
    animation:
      exito-elastico 360ms cubic-bezier(0.34, 1.56, 0.64, 1),
      pulso 700ms ease-out;
  }
  .boton[data-estado='exito'] .boton__exito {
    visibility: visible;
  }

  /* 200 ms · error: sacudida corta (el mensaje va en el campo) */
  .boton[data-estado='error'] {
    animation: sacudida 320ms ease-in-out;
  }

  .boton:disabled,
  .boton[aria-disabled='true'][data-estado='normal'] {
    background: var(--paper);
    color: var(--ink3);
    box-shadow: none;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .boton:hover,
    .boton:active {
      transform: none !important;
    }
  }
</style>
