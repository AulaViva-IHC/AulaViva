---
// Act. 20 · Tarjeta SAM "¿Cómo te sentiste?" al terminar un flujo crítico.
// Solo se abre si hay una sesión SAM activa (sessionStorage, la crea /actividad-20) del mismo flujo:
//   flujo A → en /resultado/[id] al emitir el certificado (A5) o al ver un resultado desaprobado (A4)
//   flujo B → en /admin/cursos al llegar después de publicar el curso (B5)
// Sin sesión SAM no se ve nada: la pantalla funciona como siempre.
//
// 4 pasos (chunking, §5.1: una decisión a la vez): Valencia, Activación, Control y "¿Qué paso te costó
// más?" + comentario. Cada escala es un grupo de 9 radios nativos (las flechas del teclado ya funcionan)
// con 5 figuras propias (FiguraSam) y 4 puntos intermedios; cada radio se anuncia como "5 de 9, neutral".
// "Guardar respuesta" (BotonMultimodal completo) → firma de Éxito → vuelve a /actividad-20.
// Lógica: src/scripts/sam.ts. Textos: rama "sam" de src/i18n/es.json y qu.json.
import Modal from './Modal.astro';
import Boton from './Boton.astro';
import BotonMultimodal from './BotonMultimodal.astro';
import Campo from './Campo.astro';
import Icono from './Icono.astro';
import FiguraSam from './FiguraSam.astro';
import { DIMENSIONES, LIMITE_COMENTARIO, PASOS, POSICIONES, type FlujoSam } from '../lib/sam';
import { textosDeRamas, traductor } from '../i18n';

interface Props {
  flujo: FlujoSam;
}
const { flujo } = Astro.props;
const t = traductor(Astro.locals.idioma, Astro.locals.estres);
const textos = textosDeRamas(Astro.locals.idioma, Astro.locals.estres, 'sam');
---

<div class="sam" data-sam={flujo}>
  <Modal id="modal-sam" titulo={t('sam.titulo')} amplio describir={false}>
    <p class="sam__intro" data-sam-terminaste>{t('sam.intro')}</p>
    <p class="sam__contador pequeno" aria-live="polite" data-sam-contador>{t('sam.paso', { n: 1 })}</p>
    <div class="progreso sam__progreso" aria-hidden="true"><span class="progreso__avance" data-sam-barra style="width: 25%"></span></div>

    {
      DIMENSIONES.map((d, i) => (
        <fieldset class="sam__seccion" data-sam-seccion={i + 1} hidden={i > 0} aria-describedby={`sam-${d}-ayuda sam-${d}-error`}>
          <legend class="sam__leyenda">
            <span class="sam__dimension">{t(`sam.${d}.titulo`)}</span>
            <span class="sam__pregunta">{t(`sam.${d}.pregunta`)}</span>
          </legend>
          <p class="pequeno secundario" id={`sam-${d}-ayuda`}>{t('sam.posicionesAyuda')}</p>
          <div class="sam__escala">
            {POSICIONES.map((n) => (
              <label class:list={['sam__op', n % 2 ? 'sam__op--figura' : 'sam__op--punto']}>
                <input
                  class="sam__radio"
                  type="radio"
                  name={`sam-${d}`}
                  value={n}
                  aria-label={t('sam.posicion', { n, texto: t(`sam.${d}.n${n}`) })}
                  data-sam-dimension={d}
                />
                <span class="sam__dibujo" aria-hidden="true">
                  {n % 2 ? <FiguraSam dimension={d} nivel={((n + 1) / 2) as 1 | 2 | 3 | 4 | 5} /> : <span class="sam__punto" />}
                </span>
                <span class="sam__num" aria-hidden="true">{n}</span>
                <span class="sam__texto" aria-hidden="true">{t(`sam.${d}.n${n}`)}</span>
                <span class="sam__check" aria-hidden="true"><Icono nombre="check" tamano={14} /></span>
              </label>
            ))}
          </div>
          <div class="sam__extremos" aria-hidden="true">
            <span>1 · {t(`sam.${d}.min`)}</span>
            <span>9 · {t(`sam.${d}.max`)}</span>
          </div>
          <p class="sam__error" id={`sam-${d}-error`} data-sam-error hidden>
            <Icono nombre="alerta" tamano={16} />
            <span>{t('sam.elige')}</span>
          </p>
        </fieldset>
      ))
    }

    <div class="sam__seccion" data-sam-seccion="4" hidden>
      <fieldset class="sam__pasos" aria-describedby="sam-paso-error">
        <legend class="sam__leyenda">
          <span class="sam__pregunta">{t('sam.pasoTitulo')}</span>
        </legend>
        <div class="sam__lista">
          {
            PASOS[flujo].map((p) => (
              <label class="sam__opcion">
                <input type="radio" name="sam-paso" value={p} />
                <span class="sam__codigo">{p}</span>
                <span>{t(`sam.pasos.${p}`)}</span>
                <span class="sam__check-opcion" aria-hidden="true"><Icono nombre="check" tamano={16} /></span>
              </label>
            ))
          }
        </div>
        <p class="sam__error" id="sam-paso-error" data-sam-error hidden>
          <Icono nombre="alerta" tamano={16} />
          <span>{t('sam.pasoFalta')}</span>
        </p>
      </fieldset>
      <Campo
        id="sam-comentario"
        etiqueta={t('sam.comentario')}
        ayuda={t('sam.comentarioAyuda')}
        como="textarea"
        rows={3}
        maxlength={LIMITE_COMENTARIO}
        data-sam-comentario
      >
        <span slot="extra" class="pequeno secundario" data-sam-caracteres aria-hidden="true">{t('sam.contador', { n: 0 })}</span>
      </Campo>
    </div>

    <p class="aviso aviso--error sam__aviso" data-sam-aviso hidden>
      <Icono nombre="alerta" />
      <span data-sam-aviso-texto></span>
    </p>

    <Fragment slot="acciones">
      <div class="sam__izquierda">
        <Boton variante="secundario" data-sam-despues>{t('sam.despues')}</Boton>
        <BotonMultimodal variante="secundario" modo="toque" data-sam-anterior hidden>
          <Icono nombre="flecha-izq" tamano={18} />
          {t('sam.anterior')}
        </BotonMultimodal>
      </div>
      <div class="sam__derecha">
        <BotonMultimodal variante="principal" modo="toque" data-sam-siguiente>
          {t('sam.siguiente')}
          <Icono nombre="flecha-der" tamano={18} />
        </BotonMultimodal>
        <BotonMultimodal
          variante="principal"
          modo="completo"
          textoCargando={t('sam.guardando')}
          textoExito={t('sam.guardado')}
          anuncioExito={t('sam.guardadoAnuncio')}
          data-sam-guardar
          hidden
        >
          <Icono nombre="guardar" tamano={18} />
          {t('sam.guardar')}
        </BotonMultimodal>
      </div>
    </Fragment>
  </Modal>

  <!-- Si la tarjeta se cierra sin guardar: recordatorio para volver a abrirla -->
  <div class="sam-pendiente" role="region" aria-label={t('sam.titulo')} data-sam-pendiente hidden>
    <p><Icono nombre="info" tamano={18} /> {t('sam.pendiente')}</p>
    <Boton variante="secundario" data-sam-reabrir>{t('sam.responder')}</Boton>
  </div>

  <script type="application/json" id="textos-sam" set:html={JSON.stringify(textos)} />
</div>

<script>
  import { iniciarTarjetaSam } from '../scripts/sam';
  iniciarTarjetaSam();
</script>

<style>
  .sam :global(.boton[hidden]) {
    display: none;
  }
  .sam__intro {
    color: var(--ink);
  }
  .sam__contador {
    color: var(--ink2);
    font-weight: 600;
  }
  .sam__progreso {
    margin-top: calc(-1 * var(--e2));
  }
  .sam__seccion {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .sam__seccion[hidden] {
    display: none;
  }
  .sam__pasos {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .sam__leyenda {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding: 0;
    margin-bottom: var(--e2);
  }
  .sam__dimension {
    color: var(--indigo3);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sam__pregunta {
    color: var(--ink);
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    font-weight: 700;
  }

  /* ─── Escala de 9 posiciones ─────────────────────────────────── */
  .sam__escala {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--e1);
  }
  .sam__op {
    position: relative;
    display: grid;
    grid-template-rows: 80px auto;
    justify-items: center;
    align-items: end;
    gap: var(--e1);
    min-width: 44px;
    min-height: 44px;
    padding: var(--e2) var(--e1);
    border-radius: var(--radio-control);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--t-rapido), transform var(--t-rapido);
  }
  .sam__op--punto {
    background: transparent;
  }
  .sam__op:hover {
    background: var(--indigo-t);
  }
  .sam__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .sam__dibujo {
    display: grid;
    place-items: end center;
    width: 56px;
    height: 72px;
    --figura-relleno: var(--lila);
  }
  .sam__punto {
    display: block;
    width: 12px;
    height: 12px;
    margin-bottom: 28px;
    border-radius: 50%;
    background: var(--ink3);
  }
  .sam__num {
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
    color: var(--ink2);
  }
  .sam__texto {
    display: none;
  }
  .sam__check {
    position: absolute;
    top: var(--e1);
    right: var(--e1);
    display: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--indigo3);
    color: var(--white);
  }
  /* Seleccionada: fondo de selección + check + número en negrita (nunca solo color) */
  .sam__op:has(:checked) {
    background: var(--indigo-t);
    box-shadow: inset 0 0 0 2px var(--indigo3);
  }
  .sam__op:has(:checked) .sam__check {
    display: grid;
  }
  .sam__op:has(:checked) .sam__num {
    color: var(--ink);
    font-weight: 800;
  }
  .sam__op:has(:checked) .sam__punto {
    background: var(--indigo3);
    transform: scale(1.5);
  }
  .sam__op:has(:focus-visible) {
    outline: 4px solid var(--foco);
    outline-offset: 2px;
  }
  .sam__extremos {
    display: flex;
    justify-content: space-between;
    gap: var(--e3);
    color: var(--ink2);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
  }
  .sam__extremos span:last-child {
    text-align: right;
  }
  .sam__error {
    display: flex;
    align-items: flex-start;
    gap: var(--e2);
    margin-top: var(--e2);
    color: var(--red);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
  }
  .sam__error[hidden] {
    display: none;
  }

  /* ─── ¿Qué paso te costó más? ────────────────────────────────── */
  .sam__lista {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .sam__opcion {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--e3);
    min-height: 48px;
    padding: var(--e2) var(--e3);
    border-radius: var(--radio-control);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .sam__opcion input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .sam__codigo {
    font-weight: 800;
    color: var(--indigo3);
  }
  .sam__check-opcion {
    visibility: hidden;
    color: var(--indigo3);
  }
  .sam__opcion:hover {
    background: var(--indigo-t);
  }
  .sam__opcion:has(:checked) {
    background: var(--indigo-t);
    box-shadow: inset 0 0 0 2px var(--indigo3);
    font-weight: 600;
  }
  .sam__opcion:has(:checked) .sam__check-opcion {
    visibility: visible;
  }
  .sam__opcion:has(:focus-visible) {
    outline: 4px solid var(--foco);
    outline-offset: 2px;
  }
  .sam__aviso {
    margin-top: 0;
  }

  /* Acciones: izquierda (Responder después / Anterior) y derecha (Siguiente / Guardar) */
  .sam__izquierda,
  .sam__derecha {
    display: grid;
  }
  .sam__izquierda :global(.boton),
  .sam__derecha :global(.boton) {
    width: 100%;
  }

  /* Recordatorio si se cerró sin guardar */
  .sam-pendiente {
    position: fixed;
    right: var(--e4);
    bottom: var(--e4);
    z-index: 40;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--e3);
    max-width: min(520px, calc(100vw - 32px));
    padding: var(--e3) var(--e4);
    border-radius: var(--radio-tarjeta);
    background: var(--indigo);
    color: var(--white);
    box-shadow: var(--sombra-2);
  }
  .sam-pendiente[hidden] {
    display: none;
  }
  .sam-pendiente p {
    display: flex;
    align-items: center;
    gap: var(--e2);
    font-weight: 600;
  }

  /* Móvil: las 9 posiciones en columna, cada una con su texto (44 px de alto como mínimo) */
  @media (max-width: 599px) {
    .sam__pregunta {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
    .sam__escala {
      grid-template-columns: 1fr;
      gap: var(--e1);
    }
    .sam__op {
      grid-template-rows: none;
      grid-template-columns: 48px 20px 1fr;
      justify-items: start;
      align-items: center;
      gap: var(--e2);
      min-height: 48px;
      padding: var(--e1) var(--e3) var(--e1) var(--e2);
    }
    .sam__op--punto {
      background: var(--paper);
    }
    .sam__dibujo {
      width: 36px;
      height: 46px;
      justify-self: center;
    }
    .sam__op--punto .sam__dibujo {
      height: 24px;
      place-items: center;
    }
    .sam__punto {
      margin: 0;
    }
    .sam__texto {
      display: block;
      padding-right: var(--e4);
    }
    .sam__check {
      top: 50%;
      right: var(--e3);
      transform: translateY(-50%);
    }
    .sam__extremos {
      display: none; /* cada fila ya dice su texto */
    }
    .sam-pendiente {
      right: var(--e3);
      bottom: var(--e3);
      left: var(--e3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sam__op,
    .sam__opcion {
      transition: none;
    }
  }

  /* Act. 18 · Alto contraste: borde de 2 px; seleccionado = índigo sólido con texto blanco + check */
  :global(:root[data-contraste='alto']) .sam__op,
  :global(:root[data-contraste='alto']) .sam__opcion {
    border: 2px solid #000 !important;
    background: #fff !important;
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:checked),
  :global(:root[data-contraste='alto']) .sam__opcion:has(:checked) {
    background: var(--indigo) !important;
    color: #fff !important;
    box-shadow: none !important;
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:checked) .sam__num,
  :global(:root[data-contraste='alto']) .sam__op:has(:checked) .sam__texto,
  :global(:root[data-contraste='alto']) .sam__opcion:has(:checked) .sam__codigo,
  :global(:root[data-contraste='alto']) .sam__opcion:has(:checked) .sam__check-opcion {
    color: #fff !important;
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:checked) .sam__dibujo {
    background: #fff;
    border-radius: var(--radio-control);
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:checked) .sam__check {
    background: #fff;
    color: var(--indigo);
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:checked) .sam__punto {
    background: #fff;
  }
  :global(:root[data-contraste='alto']) .sam__op:has(:focus-visible),
  :global(:root[data-contraste='alto']) .sam__opcion:has(:focus-visible) {
    outline: 3px solid #000 !important;
    outline-offset: 3px;
  }
  :global(:root[data-contraste='alto']) .sam__punto {
    background: #000;
  }
  :global(:root[data-contraste='alto']) .sam-pendiente {
    border: 2px solid #fff;
    box-shadow: none;
  }
  @media (forced-colors: active) {
    .sam__op:has(:checked),
    .sam__opcion:has(:checked) {
      outline: 3px solid Highlight;
    }
    .sam__op,
    .sam__opcion {
      border: 2px solid ButtonText;
    }
  }
</style>
