---
// Pie de las páginas públicas (01-catalogo, 02-detalle, 10-verificar).
// Act. 17: textos traducidos (data-i18n) y "Actualizado: <fecha y hora del servidor>"
// con los formatos regionales (DD/MM/AAAA · 12 h en español, 24 h en quechua, zona Lima).
import Logo from './Logo.astro';
import { formatearFechaHora, traductor } from '../i18n';

const { idioma, estres } = Astro.locals;
const t = traductor(idioma, estres);
const ahora = new Date();
---

<footer class="pie oscuro" lang={idioma} data-i18n-lang>
  <div class="pie__marca">
    <Logo tono="claro" i18n />
    <p class="pie__texto" data-i18n="pie.escuela">{t('pie.escuela')}</p>
    <p class="pie__texto">
      <span data-i18n="pie.actualizado">{t('pie.actualizado')}</span>:
      <time datetime={ahora.toISOString()} data-formato="fecha-hora">{formatearFechaHora(ahora, idioma)}</time>
    </p>
  </div>
  <nav aria-label={t('pie.navegacion')} data-i18n-attr="aria-label:pie.navegacion">
    <ul class="pie__enlaces">
      <li><a href="/terminos#privacidad" data-i18n="pie.privacidad">{t('pie.privacidad')}</a></li>
      <li><a href="/terminos" data-i18n="pie.terminos">{t('pie.terminos')}</a></li>
      <li><a href="/verificar" data-i18n="pie.verificar">{t('pie.verificar')}</a></li>
    </ul>
  </nav>
</footer>

<style>
  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--e4);
    padding: var(--e6) var(--e7);
    background: var(--indigo);
    color: var(--white);
  }
  .pie__marca {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    min-width: 0;
  }
  .pie__texto {
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    color: rgb(255 255 255 / 0.85);
  }
  .pie__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e1) var(--e4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pie__enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: var(--alto-control);
    color: rgb(255 255 255 / 0.9);
    font-weight: 500;
  }
  .pie__enlaces a:hover {
    color: var(--white);
  }
  @media (max-width: 1199px) {
    .pie {
      padding: var(--e6) var(--e4);
    }
  }
  @media (max-width: 600px) {
    .pie {
      padding: var(--e5) var(--e3);
    }
  }
</style>
