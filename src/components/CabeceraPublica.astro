---
// Cabecera pública (01-catalogo, 02-detalle, 10-verificar): logo, 3 enlaces y la cuenta.
// Ley de Hick: aquí no hay botón amarillo; la acción principal es la de cada página.
// Sin sesión: "Iniciar sesión" (enlace) y "Crear cuenta" (secundario). Con sesión: "Ir a mi Inicio".
// Act. 17: selector de idioma ("Idioma": Español / Quechua) antes de la cuenta; textos con data-i18n.
// Act. 18: interruptor "Alto contraste" junto al selector de idioma.
import Logo from './Logo.astro';
import Boton from './Boton.astro';
import Icono from './Icono.astro';
import InterruptorContraste from './InterruptorContraste.astro';
import { destinoPorRol } from '../lib/auth';
import { IDIOMAS, t as tBase, traductor } from '../i18n';

export type SeccionPublica = 'cursos' | 'como-funciona' | 'verificar' | 'ninguna';

interface Props {
  activo?: SeccionPublica;
}
const { activo = 'ninguna' } = Astro.props;
const usuario = Astro.locals.usuario;
const enPortada = Astro.url.pathname === '/';

const { idioma, estres } = Astro.locals;
const t = traductor(idioma, estres);

const ENLACES: { id: SeccionPublica; clave: string; href: string }[] = [
  { id: 'cursos', clave: 'nav.cursos', href: enPortada ? '#cursos' : '/#cursos' },
  { id: 'como-funciona', clave: 'nav.comoFunciona', href: enPortada ? '#como-funciona' : '/#como-funciona' },
  { id: 'verificar', clave: 'nav.verificar', href: '/verificar' },
];
---

<a class="saltar" href="#contenido" lang={idioma} data-i18n-lang data-i18n="meta.saltar">{t('meta.saltar')}</a>
<header class="cabecera-publica" lang={idioma} data-i18n-lang>
  <Logo i18n />
  <nav class="cabecera-publica__nav" aria-label={t('nav.principal')} data-i18n-attr="aria-label:nav.principal">
    <ul>
      {
        ENLACES.map((e) => (
          <li>
            <a href={e.href} class="cabecera-publica__enlace" aria-current={e.id === activo ? 'page' : undefined} data-i18n={e.clave}>
              {t(e.clave)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="cabecera-publica__cuenta">
    <div class="idioma" role="group" aria-labelledby="idioma-etiqueta" data-selector-idioma>
      <!-- "Idioma" y los nombres "Español" / "Quechua" son iguales en los dos idiomas: no cambian con el selector -->
      <span class="idioma__etiqueta" id="idioma-etiqueta" lang="es">{tBase(idioma, 'idioma.etiqueta')}</span>
      <span class="idioma__opciones">
        {
          IDIOMAS.map((i) => (
            <button type="button" class="idioma__opcion" lang={i} aria-pressed={i === idioma ? 'true' : 'false'} data-idioma-opcion={i}>
              <span class="idioma__check" aria-hidden="true"><Icono nombre="check" tamano={16} /></span>
              {tBase(i, `idioma.${i}`)}
            </button>
          ))
        }
      </span>
    </div>
    <InterruptorContraste i18n />
    {
      usuario ? (
        <Boton variante="secundario" href={destinoPorRol(usuario)} textoCargando={t('nav.abriendo')} claveCargando="nav.abriendo">
          <span data-i18n="nav.irInicio">{t('nav.irInicio')}</span>
        </Boton>
      ) : (
        <>
          <a href="/login" class="cabecera-publica__enlace cabecera-publica__login" data-i18n="nav.iniciarSesion">{t('nav.iniciarSesion')}</a>
          <Boton variante="secundario" href="/registro" textoCargando={t('nav.abriendo')} claveCargando="nav.abriendo">
            <span data-i18n="nav.crearCuenta">{t('nav.crearCuenta')}</span>
          </Boton>
        </>
      )
    }
  </div>
</header>

<script>
  import { iniciarSelector } from '../scripts/idioma';
  for (const grupo of document.querySelectorAll<HTMLElement>('[data-selector-idioma]')) iniciarSelector(grupo);
</script>

<style>
  .cabecera-publica {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--e3) var(--e4);
    flex-wrap: wrap;
    min-height: 72px;
    padding: var(--e2) var(--e7);
    background: var(--white);
  }
  .cabecera-publica__nav {
    margin-left: auto;
  }
  .cabecera-publica__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cabecera-publica__enlace {
    display: inline-flex;
    align-items: center;
    min-height: var(--alto-control);
    padding: 0 var(--e3);
    border-radius: var(--radio-control);
    color: var(--ink2);
    font-weight: 600;
    box-shadow: inset 0 -3px 0 transparent;
    transition:
      color var(--t-rapido) ease-out,
      box-shadow var(--t-rapido) ease-out,
      background-color var(--t-rapido) ease-out;
  }
  .cabecera-publica__enlace:hover {
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
  }
  .cabecera-publica__enlace[aria-current='page'] {
    color: var(--indigo3);
    box-shadow: inset 0 -3px 0 var(--indigo3);
    border-radius: 0;
  }
  .cabecera-publica__cuenta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--e2);
  }

  /* ─── Selector de idioma (Act. 17) ─────────────────── */
  .idioma {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e1) var(--e2);
  }
  .idioma__etiqueta {
    color: var(--ink2);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
  }
  /* Región común: las dos opciones sobre el mismo fondo gris */
  .idioma__opciones {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radio-control);
    background: var(--paper);
  }
  .idioma__opcion {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: fit-content;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radio-control);
    background: transparent;
    color: var(--ink2);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--t-rapido) ease-out,
      color var(--t-rapido) ease-out,
      box-shadow var(--t-rapido) ease-out,
      transform var(--t-rapido) ease-out;
  }
  .idioma__opcion:hover {
    background: var(--white);
    color: var(--ink);
  }
  .idioma__opcion:active {
    transform: scale(0.97);
    transition-duration: 40ms;
  }
  /* Elegido: fondo de selección + borde + check (nunca solo color) */
  .idioma__opcion[aria-pressed='true'] {
    background: var(--indigo-t);
    color: var(--indigo3);
    box-shadow: inset 0 0 0 2px var(--indigo3);
  }
  .idioma__check {
    display: none;
  }
  .idioma__opcion[aria-pressed='true'] .idioma__check {
    display: inline-grid;
  }
  /* Firma de Éxito al cambiar: verde con check */
  .idioma__opcion[data-estado='exito'] {
    background: var(--grn-t);
    color: var(--grn);
    box-shadow: inset 0 0 0 2px var(--grn);
  }
  .cabecera-publica__login {
    color: var(--ink);
    font-weight: 700;
  }
  .saltar {
    position: absolute;
    left: var(--e3);
    top: -100px;
    z-index: 50;
    padding: 12px var(--e3);
    border-radius: var(--radio-control);
    background: var(--yellow);
    color: var(--ink);
  }
  .saltar:focus {
    top: var(--e3);
  }
  @media (max-width: 1199px) {
    .cabecera-publica {
      padding: var(--e2) var(--e4);
    }
  }
  /* Móvil: el logo y la cuenta arriba; los enlaces en una segunda fila */
  @media (max-width: 899px) {
    .cabecera-publica {
      position: static;
      padding: var(--e2) var(--e3);
    }
    .cabecera-publica__cuenta {
      margin-left: auto;
    }
    .cabecera-publica__nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
    .cabecera-publica__enlace {
      padding: 0 12px;
    }
  }
  @media (max-width: 479px) {
    .cabecera-publica__login {
      padding: 0 var(--e2);
    }
    /* Móvil: el selector ocupa su propia fila, debajo del logo */
    .cabecera-publica__cuenta {
      margin-left: 0;
      justify-content: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .idioma__opcion:active {
      transform: none;
    }
  }
</style>
