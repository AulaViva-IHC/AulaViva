---
// Estado de error (UI Stack): qué pasó + "Reintentar".
// El botón lleva data-accion="reintentar"; el script de la página decide qué reintentar.
// `variante`: "principal" cuando el error ocupa la pantalla (es la única acción);
// "secundario" cuando convive con la acción principal.
// Act. 17: con la prop i18n los textos salen del diccionario (error.*) y cambian con el selector de idioma;
// claveTitulo y claveTexto reemplazan las claves por defecto. Sin i18n, todo sigue en español.
import Icono from './Icono.astro';
import Boton from './Boton.astro';
import BotonMultimodal from './BotonMultimodal.astro';
import { traductor } from '../i18n';

interface Props {
  titulo?: string;
  texto?: string;
  variante?: 'principal' | 'secundario';
  /** Botón con respuesta visual, auditiva y háptica (§5.8): éxito o error según el resultado. */
  multimodal?: boolean;
  /** Act. 17: textos traducidos con el idioma de la página. */
  i18n?: boolean;
  claveTitulo?: string;
  claveTexto?: string;
  class?: string;
  hidden?: boolean;
  [atributo: `data-${string}`]: string | boolean | undefined;
}
const {
  titulo: tituloPropio,
  texto: textoPropio,
  variante = 'principal',
  multimodal = false,
  i18n = false,
  claveTitulo,
  claveTexto,
  class: clase,
  ...resto
} = Astro.props;
const t = traductor(i18n ? Astro.locals.idioma : 'es', i18n && Astro.locals.estres);
// Con i18n, cada texto tiene clave (salvo que la página pase un texto propio sin clave).
const k = (clave: string | undefined, propio: string | undefined, porDefecto: string) =>
  i18n ? (clave ?? (propio ? undefined : porDefecto)) : undefined;
const kTitulo = k(claveTitulo, tituloPropio, 'error.titulo');
const kTexto = k(claveTexto, textoPropio, 'error.texto');
const titulo = kTitulo ? t(kTitulo) : (tituloPropio ?? t('error.titulo'));
const texto = kTexto ? t(kTexto) : (textoPropio ?? t('error.texto'));
const kBoton = (clave: string) => (i18n ? clave : undefined);
---

<div class:list={['error', clase]} role="alert" {...resto}>
  <span class="error__icono"><Icono nombre="sin-conexion" tamano={28} /></span>
  <h2 class="h2" data-error-titulo data-i18n={kTitulo}>{titulo}</h2>
  <p class="secundario error__texto" data-error-texto data-i18n={kTexto}>{texto}</p>
  {
    multimodal ? (
      <BotonMultimodal
        variante={variante}
        data-accion="reintentar"
        textoCargando={t('error.reintentando')}
        textoExito={t('error.cargado')}
        claveCargando={kBoton('error.reintentando')}
        claveExito={kBoton('error.cargado')}
        modo="completo"
      >
        <Icono nombre="reintentar" tamano={18} />
        <span data-i18n={kBoton('error.reintentar')}>{t('error.reintentar')}</span>
      </BotonMultimodal>
    ) : (
      <Boton variante={variante} data-accion="reintentar" textoCargando={t('error.reintentando')} claveCargando={kBoton('error.reintentando')}>
        <Icono nombre="reintentar" tamano={18} />
        <span data-i18n={kBoton('error.reintentar')}>{t('error.reintentar')}</span>
      </Boton>
    )
  }
</div>

<style>
  .error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e2);
    padding: var(--e5) var(--e3);
    text-align: center;
  }
  .error[hidden] {
    display: none;
  }
  .error__icono {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--e2);
    border-radius: 50%;
    background: var(--red-t);
    color: var(--red);
  }
  .error__texto {
    max-width: 46ch;
    margin-bottom: var(--e3);
  }
</style>
