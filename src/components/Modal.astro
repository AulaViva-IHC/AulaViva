---
// Modal de confirmación (modal-enviar-evaluacion.png, modal-confirmar-nombre.png).
// <dialog> nativo con showModal(): atrapa el foco, cierra con Esc y marca el resto como inerte.
// Se abre con abrirModal(id) de src/scripts/modal.ts, que devuelve el foco al control que lo abrió.
// Contenido en el slot; las acciones en la ranura "acciones" (secundaria a la izquierda, principal a la derecha).
import Icono, { type NombreIcono } from './Icono.astro';

interface Props {
  id: string;
  titulo: string;
  /** Icono sobre el título (en un círculo del tono indicado). */
  icono?: NombreIcono;
  tono?: 'advertencia' | 'info';
}
const { id, titulo, icono, tono = 'advertencia' } = Astro.props;
---

<dialog class="modal" id={id} aria-labelledby={`${id}-titulo`} aria-describedby={`${id}-texto`} data-modal>
  <div class="modal__cuerpo">
    {icono && <span class:list={['modal__icono', `modal__icono--${tono}`]} aria-hidden="true"><Icono nombre={icono} tamano={32} /></span>}
    <h2 class="modal__titulo" id={`${id}-titulo`} data-modal-titulo>{titulo}</h2>
    <div class="modal__texto" id={`${id}-texto`}>
      <slot />
    </div>
    <div class="modal__acciones">
      <slot name="acciones" />
    </div>
  </div>
</dialog>

<script>
  import { iniciarModales } from '../scripts/modal';
  iniciarModales();
</script>

<style>
  .modal {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--radio-tarjeta);
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 24px 64px rgb(23 21 59 / 0.28); /* flota sobre la página */
  }
  .modal::backdrop {
    background: rgb(23 21 59 / 0.55);
  }
  .modal[open] {
    animation: modal-entra 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes modal-entra {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  .modal__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    padding: var(--e6) var(--e6) var(--e5);
  }
  .modal__icono {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--e2);
    border-radius: 50%;
  }
  .modal__icono[hidden] {
    display: none;
  }
  .modal__icono--advertencia { background: var(--org-t); color: var(--org); }
  .modal__icono--info { background: var(--indigo-t); color: var(--indigo3); }
  .modal__titulo {
    font-size: 1.75rem;
    line-height: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .modal__texto {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    color: var(--ink2);
    font-size: 1.0625rem;
    line-height: 1.625rem;
  }
  .modal__acciones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e3);
    margin-top: var(--e3);
  }
  .modal__acciones :global(.boton) {
    width: 100%;
  }
  @media (max-width: 599px) {
    .modal__cuerpo {
      padding: var(--e5) var(--e4) var(--e4);
    }
    .modal__acciones {
      grid-template-columns: 1fr;
    }
    /* En móvil la acción principal va arriba, al alcance del pulgar */
    .modal__acciones > :global(:last-child) {
      order: -1;
    }
  }
</style>
