---
// Estado parcial (UI Stack): una parte no cargó; el resto de la pantalla sigue funcionando.
// "No se pudo cargar esta parte" + "Reconectar" (data-accion="reconectar").
// tono "oscuro" para usarlo sobre el panel índigo.
// Act. 17: con la prop i18n los textos salen del diccionario (parcial.*; claveTexto para el texto propio).
import Icono from './Icono.astro';
import Boton from './Boton.astro';
import BotonMultimodal from './BotonMultimodal.astro';
import { traductor } from '../i18n';

interface Props {
  texto?: string;
  tono?: 'claro' | 'oscuro';
  /** Botón con respuesta visual, auditiva y háptica (§5.8): éxito o error según el resultado. */
  multimodal?: boolean;
  /** Act. 17: textos traducidos con el idioma de la página. */
  i18n?: boolean;
  claveTexto?: string;
  class?: string;
  hidden?: boolean;
  [atributo: `data-${string}`]: string | boolean | undefined;
}
const {
  texto: textoPropio,
  tono = 'claro',
  multimodal = false,
  i18n = false,
  claveTexto,
  class: clase,
  ...resto
} = Astro.props;
const t = traductor(i18n ? Astro.locals.idioma : 'es', i18n && Astro.locals.estres);
const kTexto = i18n ? (claveTexto ?? (textoPropio ? undefined : 'parcial.texto')) : undefined;
const texto = kTexto ? t(kTexto) : (textoPropio ?? t('parcial.texto'));
const k = (clave: string) => (i18n ? clave : undefined);
---

<div class:list={['parcial', `parcial--${tono}`, clase]} role="status" {...resto}>
  <span class="parcial__icono"><Icono nombre="sin-conexion" tamano={20} /></span>
  <div>
    <p class="parcial__titulo" data-i18n={k('parcial.titulo')}>{t('parcial.titulo')}</p>
    <p class="parcial__texto" data-i18n={kTexto}>{texto}</p>
  </div>
  {
    multimodal ? (
      <BotonMultimodal
        variante="secundario"
        data-accion="reconectar"
        textoCargando={t('parcial.reconectando')}
        textoExito={t('parcial.conectado')}
        claveCargando={k('parcial.reconectando')}
        claveExito={k('parcial.conectado')}
        modo="completo"
      >
        <Icono nombre="reintentar" tamano={18} />
        <span data-i18n={k('parcial.reconectar')}>{t('parcial.reconectar')}</span>
      </BotonMultimodal>
    ) : (
      <Boton variante="secundario" data-accion="reconectar" textoCargando={t('parcial.reconectando')} claveCargando={k('parcial.reconectando')}>
        <Icono nombre="reintentar" tamano={18} />
        <span data-i18n={k('parcial.reconectar')}>{t('parcial.reconectar')}</span>
      </Boton>
    )
  }
</div>

<style>
  .parcial {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e2) var(--e3);
    align-items: start;
  }
  .parcial[hidden] {
    display: none;
  }
  .parcial__icono {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--org-t);
    color: var(--org);
  }
  .parcial__titulo {
    font-weight: 700;
  }
  .parcial__texto {
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    color: var(--ink2);
  }
  .parcial--oscuro .parcial__texto {
    color: rgb(255 255 255 / 0.8);
  }
  .parcial :global(.boton) {
    grid-column: 2;
    justify-self: start;
    min-height: 40px;
  }
</style>
