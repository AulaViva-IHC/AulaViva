---
// Catálogo público (portada) · referencias/pantallas/01-catalogo.png
// Encabezado con el curso destacado (/api/cursos/destacado, aparte: si falla, estado parcial),
// 3 beneficios, el catálogo con filtros (CatalogoCursos), "Así aprendes" y los 5 pasos del certificado.
// Ley de Hick: la única acción amarilla es "Ver el curso"; el resto es secundario.
// Act. 17: toda la interfaz sale del diccionario (src/i18n) en el idioma de la cookie y cambia al
// instante con el selector de la cabecera (data-i18n). El título y la bajada del curso destacado salen en
// quechua si el curso los tiene (portada.ts pone el lang). Prueba de estrés en desarrollo: /?i18n=estres.
// Lógica del navegador: src/scripts/portada.ts (encabezado) y src/scripts/catalogo.ts (rejilla).
import Publico from '../layouts/Publico.astro';
import Boton from '../components/Boton.astro';
import BotonMultimodal from '../components/BotonMultimodal.astro';
import Badge from '../components/Badge.astro';
import Icono, { type NombreIcono } from '../components/Icono.astro';
import EstadoParcial from '../components/EstadoParcial.astro';
import CatalogoCursos from '../components/CatalogoCursos.astro';
import { destinoPorRol } from '../lib/auth';
import { traductor } from '../i18n';

const SIMULACIONES = ['ideal', 'vacio', 'cargando', 'error', 'parcial'];
const pedido = Astro.url.searchParams.get('simular') ?? '';
const simular = import.meta.env.DEV && SIMULACIONES.includes(pedido) ? pedido : '';
const usuario = Astro.locals.usuario;
const t = traductor(Astro.locals.idioma, Astro.locals.estres);

const BENEFICIOS: { icono: NombreIcono; id: string }[] = [
  { icono: 'reloj', id: 'ritmo' },
  { icono: 'subtitulos', id: 'subtitulos' },
  { icono: 'medalla', id: 'qr' },
];

// Act. 18: en orden de lectura (la rueda que los ordenaba en círculo se quitó)
const CICLO = ['mira', 'practica', 'evalua', 'certifica'];

const PASOS: { clave: string; icono: NombreIcono }[] = [
  { clave: 'pasos.crearCuenta', icono: 'usuario-mas' },
  { clave: 'pasos.inscribete', icono: 'libro' },
  { clave: 'pasos.completa', icono: 'pantalla' },
  { clave: 'pasos.aprueba', icono: 'portapapeles' },
  { clave: 'pasos.descarga', icono: 'medalla' },
];
---

<Publico
  titulo={t('meta.titulo')}
  claveTitulo="meta.titulo"
  claveDescripcion="meta.descripcion"
  seccion="cursos"
  simular={simular}
>
  <main id="contenido" tabindex="-1" class="portada-publica">
    <h1 class="solo-lector" data-i18n="heroe.h1">{t('heroe.h1')}</h1>

    <!-- Encabezado: curso destacado -->
    <section class="heroe oscuro" aria-label={t('heroe.region')} data-i18n-attr="aria-label:heroe.region">
      <div class="heroe__texto" data-destacado aria-busy="true">
        <div class="heroe__esqueleto" data-destacado-cargando aria-hidden="true">
          <span class="skeleton sk sk--etiqueta"></span>
          <span class="skeleton sk sk--titulo"></span>
          <span class="skeleton sk sk--titulo sk--corto"></span>
          <span class="skeleton sk sk--linea"></span>
          <span class="skeleton sk sk--linea sk--corto"></span>
        </div>

        <div class="heroe__contenido" data-destacado-contenido hidden>
          <Badge tono="lila"><span data-i18n="heroe.badge">{t('heroe.badge')}</span></Badge>
          <!-- Contenido del curso: portada.ts lo pinta en el idioma actual y ajusta el lang -->
          <h2 class="heroe__titulo" lang="es" data-destacado-titulo></h2>
          <p class="heroe__bajada" lang="es" data-destacado-descripcion></p>
        </div>

        <div class="heroe__contenido" data-destacado-error hidden>
          <h2 class="heroe__titulo" data-i18n="heroe.tituloRespaldo">{t('heroe.tituloRespaldo')}</h2>
          <EstadoParcial tono="oscuro" texto={t('heroe.parcial')} i18n claveTexto="heroe.parcial" multimodal />
        </div>

        <div class="heroe__acciones">
          <span data-destacado-accion hidden>
            <BotonMultimodal
              variante="principal"
              href="/#cursos"
              modo="toque"
              textoCargando={t('heroe.abriendoCurso')}
              claveCargando="heroe.abriendoCurso"
              data-destacado-enlace
            >
              <span data-i18n="heroe.verCurso">{t('heroe.verCurso')}</span>
            </BotonMultimodal>
          </span>
          <Boton variante="secundario" href="#cursos" class="heroe__todos" textoCargando={t('heroe.bajando')} claveCargando="heroe.bajando">
            <span data-i18n="heroe.verTodos">{t('heroe.verTodos')}</span>
          </Boton>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <ul class="beneficios">
      {
        BENEFICIOS.map((b) => (
          <li class="beneficio">
            <span class="beneficio__icono"><Icono nombre={b.icono} tamano={22} /></span>
            <span class="beneficio__cuerpo">
              <span class="beneficio__titulo" data-i18n={`beneficios.${b.id}.titulo`}>{t(`beneficios.${b.id}.titulo`)}</span>
              <span class="beneficio__texto" data-i18n={`beneficios.${b.id}.texto`}>{t(`beneficios.${b.id}.texto`)}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- Catálogo -->
    <section class="seccion" id="cursos" aria-labelledby="cursos-titulo" tabindex="-1">
      <header class="seccion__encabezado">
        <h2 class="seccion__titulo" id="cursos-titulo" data-i18n="catalogo.titulo">{t('catalogo.titulo')}</h2>
        <p class="seccion__bajada" data-i18n="catalogo.bajada">{t('catalogo.bajada')}</p>
      </header>
      <CatalogoCursos etiquetadoPor="cursos-titulo" i18n />
    </section>

    <!-- Así aprendes -->
    <section class="ciclo" id="como-funciona" aria-labelledby="ciclo-titulo" tabindex="-1">
      <header class="seccion__encabezado">
        <h2 class="seccion__titulo" id="ciclo-titulo" data-i18n="ciclo.titulo">{t('ciclo.titulo')}</h2>
        <p class="seccion__bajada" data-i18n="ciclo.bajada">{t('ciclo.bajada')}</p>
      </header>
      <ol class="ciclo__pasos">
        {
          CICLO.map((id) => (
            <li class="ciclo__paso">
              <h3 class="ciclo__nombre" data-i18n={`ciclo.${id}.titulo`}>{t(`ciclo.${id}.titulo`)}</h3>
              <p class="ciclo__texto" data-i18n={`ciclo.${id}.texto`}>{t(`ciclo.${id}.texto`)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Cómo obtengo mi certificado -->
    <section class="pasos" aria-labelledby="pasos-titulo">
      <h2 class="seccion__titulo" id="pasos-titulo" data-i18n="pasos.titulo">{t('pasos.titulo')}</h2>
      <ol class="pasos__lista">
        {
          PASOS.map((p, i) => (
            <li class="paso-cert">
              <span class="paso-cert__icono">
                <Icono nombre={p.icono} tamano={26} />
              </span>
              <Badge tono="lila"><span data-i18n="pasos.paso" data-i18n-n={i + 1}>{t('pasos.paso', { n: i + 1 })}</span></Badge>
              <span class="paso-cert__texto" data-i18n={p.clave}>{t(p.clave)}</span>
            </li>
          ))
        }
      </ol>
      {
        usuario ? (
          <Boton variante="secundario" href={destinoPorRol(usuario)} textoCargando={t('nav.abriendo')} claveCargando="nav.abriendo">
            <span data-i18n="pasos.irInicio">{t('pasos.irInicio')}</span>
          </Boton>
        ) : (
          <Boton variante="secundario" href="/registro" textoCargando={t('nav.abriendo')} claveCargando="nav.abriendo">
            <span data-i18n="pasos.crearGratis">{t('pasos.crearGratis')}</span>
          </Boton>
        )
      }
    </section>
  </main>
</Publico>

<script>
  import '../scripts/portada';
</script>

<style>
  .portada-publica {
    outline: none;
  }

  /* ─── Encabezado ───────────────────────────────────── */
  /* Act. 18 (minimalismo): sin ilustración; el texto ocupa todo el encabezado */
  .heroe {
    padding: var(--e6) var(--e7) 104px;
    background: var(--indigo);
    color: var(--white);
  }
  .heroe__texto {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
    max-width: 880px;
  }
  .heroe__contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e3);
  }
  .heroe__contenido[hidden],
  .heroe__esqueleto[hidden],
  [data-destacado-accion][hidden] {
    display: none;
  }
  .heroe__titulo {
    font-size: var(--t-display);
    line-height: var(--lh-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere; /* Act. 17: solo parte palabras que no caben (quechua, estrés) */
  }
  .heroe__bajada {
    max-width: 64ch;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: rgb(255 255 255 / 0.85);
  }
  .heroe__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e3);
  }
  .heroe__esqueleto {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
  }
  .sk { display: block; }
  .sk--etiqueta { width: 140px; height: 28px; }
  .sk--titulo { width: 90%; height: 56px; }
  .sk--linea { width: 80%; height: 20px; }
  .sk--corto { width: 55%; }

  /* ─── Beneficios ───────────────────────────────────── */
  .beneficios {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e4);
    margin: -56px var(--e7) 0;
    padding: 0;
    list-style: none;
  }
  .beneficio {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: var(--e4);
    border-radius: var(--radio-tarjeta);
    background: var(--white);
  }
  .beneficio__cuerpo {
    min-width: 0;
  }
  .beneficio__icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--indigo-t);
    color: var(--indigo3);
  }
  .beneficio__titulo {
    display: block;
    font-weight: 700;
  }
  .beneficio__texto {
    display: block;
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    color: var(--ink2);
  }

  /* ─── Secciones ────────────────────────────────────── */
  .seccion {
    display: flex;
    flex-direction: column;
    gap: var(--e5);
    padding: 88px var(--e7) 104px;
    outline: none;
    scroll-margin-top: 72px;
  }
  .seccion__encabezado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e2);
    text-align: center;
  }
  .seccion__titulo {
    font-size: 2.5rem;
    line-height: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .seccion__bajada {
    max-width: 56ch;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--ink2);
  }
  .seccion :global(.filtros) {
    justify-content: center;
    flex-direction: column;
  }

  /* ─── Así aprendes ─────────────────────────────────── */
  .ciclo {
    display: flex;
    flex-direction: column;
    gap: var(--e6);
    padding: 88px var(--e7);
    background: var(--indigo-t);
    outline: none;
    scroll-margin-top: 72px;
  }
  /* Act. 18 (minimalismo): sin la rueda de cuadrantes (repetía la lista); queda solo la lista */
  .ciclo__pasos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--e4);
    width: 100%;
    max-width: 1152px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .ciclo__paso {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding: var(--e4);
    border-radius: var(--radio-tarjeta);
    background: var(--white);
  }
  .ciclo__nombre {
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    font-weight: 800;
  }
  .ciclo__texto {
    color: var(--ink2);
  }

  /* ─── Pasos del certificado ────────────────────────── */
  .pasos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e5);
    padding: 88px var(--e7) 104px;
    background: var(--white);
  }
  .pasos__lista {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--e5);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }
  .paso-cert {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: var(--e4) var(--e3);
    border-radius: var(--radio-tarjeta);
    background: var(--paper);
    text-align: center;
  }
  /* Flecha entre pasos (decorativa) */
  .paso-cert:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -21px;
    top: 50%;
    width: 9px;
    height: 9px;
    border-top: 2.5px solid var(--indigo2);
    border-right: 2.5px solid var(--indigo2);
    transform: translateY(-50%) rotate(45deg);
  }
  .paso-cert__icono {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--indigo);
    color: var(--white);
  }
  .paso-cert__texto {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  /* La insignia "Paso 1" puede pasar a 2 líneas con textos largos (Badge no lo permite por defecto) */
  .paso-cert :global(.badge) {
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  /* ─── Responsive ───────────────────────────────────── */
  @media (max-width: 1199px) {
    .heroe,
    .seccion,
    .ciclo,
    .pasos {
      padding-left: var(--e4);
      padding-right: var(--e4);
    }
    .beneficios {
      margin-left: var(--e4);
      margin-right: var(--e4);
    }
    .ciclo__pasos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pasos__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .paso-cert:nth-child(3)::after {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .heroe {
      padding-top: var(--e5);
    }
    .heroe__titulo {
      font-size: 2.5rem;
      line-height: 3rem;
    }
    .beneficios {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e3);
    }
    .seccion,
    .ciclo,
    .pasos {
      padding-top: var(--e6);
      padding-bottom: var(--e6);
    }
    .seccion__titulo {
      font-size: var(--t-h1);
      line-height: var(--lh-h1);
    }
    .pasos__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--e3);
    }
    .paso-cert::after {
      display: none;
    }
  }
  @media (max-width: 599px) {
    .heroe,
    .seccion,
    .ciclo,
    .pasos {
      padding-left: var(--e3);
      padding-right: var(--e3);
    }
    .beneficios {
      margin-left: var(--e3);
      margin-right: var(--e3);
    }
    .ciclo__pasos,
    .pasos__lista {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
