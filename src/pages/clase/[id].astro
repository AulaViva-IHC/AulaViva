---
// Clase · referencias/pantallas/06-clase.png
// El servidor arma la clase (video con subtítulos, materiales y navegación). El índice del curso
// y el progreso se piden aparte (/api/indice):
//   ideal    → todo cargó
//   vacío    → no estás inscrito (o la clase no existe): "Ver el curso" / "Ir a Mis cursos"
//   cargando → skeleton en el progreso y el índice
//   error    → el servidor no pudo leer la clase: "Reintentar" (503)
//   parcial  → el índice no cargó: "Reconectar"; el video y "Marcar como completada" siguen funcionando
// "Marcar como completada" tiene el bucle perceptual completo (Act. 10) y la redundancia sensorial (§5.8).
// La "Evaluación final" del índice se habilita solo al 100 % (CLAUDE.md §8).
// Lógica del navegador: src/scripts/clase.ts.
import App from '../../layouts/App.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Boton from '../../components/Boton.astro';
import BotonMultimodal from '../../components/BotonMultimodal.astro';
import Badge from '../../components/Badge.astro';
import Icono from '../../components/Icono.astro';
import EstadoVacio from '../../components/EstadoVacio.astro';
import EstadoError from '../../components/EstadoError.astro';
import EstadoParcial from '../../components/EstadoParcial.astro';
import { claseParaEstudiante, type ClaseVista } from '../../lib/repositorio';

const usuario = Astro.locals.usuario!;
if (usuario.rol === 'admin') return Astro.redirect('/admin/cursos/nuevo');

const SIMULACIONES = ['ideal', 'vacio', 'cargando', 'error', 'parcial'];
const pedido = Astro.url.searchParams.get('simular') ?? '';
const simular = import.meta.env.DEV && SIMULACIONES.includes(pedido) ? pedido : '';

let vista: ClaseVista | null = null;
let noInscrito: { slug: string; titulo: string } | null = null;
let fallo = simular === 'error';
if (!fallo) {
  try {
    const r = simular === 'vacio' ? null : await claseParaEstudiante(usuario.id, Number(Astro.params.id));
    if (r?.estado === 'ok') vista = r.vista;
    else if (r?.estado === 'no-inscrito') noInscrito = r.curso;
    else if (simular === 'vacio') noInscrito = { slug: 'python-desde-cero', titulo: 'Python desde cero' };
  } catch {
    fallo = true;
  }
}
if (fallo) Astro.response.status = 503;
else if (!vista) Astro.response.status = 404;
const titulo = vista ? `${vista.clase.codigo} ${vista.clase.titulo}` : 'Clase';
---

<App titulo={titulo} activo="mis-cursos" simular={simular}>
  {
    fallo && (
      <Tarjeta data-reintentar-pagina>
        <h1 class="solo-lector">Clase no disponible</h1>
        <EstadoError
          titulo="No pudimos cargar esta clase"
          texto="El servidor no respondió. Tu avance está guardado; vuelve a intentarlo en un momento."
          multimodal
        />
      </Tarjeta>
    )
  }

  {
    !fallo && !vista && (
      <Tarjeta>
        <h1 class="solo-lector">{noInscrito ? 'Aún no estás inscrito' : 'Clase no encontrada'}</h1>
        {noInscrito ? (
          <EstadoVacio
            titulo={`Inscríbete en ${noInscrito.titulo} para ver esta clase`}
            texto="La inscripción es gratis. Al inscribirte verás las clases en orden y tu avance se guardará."
            icono="candado"
          >
            <Boton variante="principal" href={`/cursos/${noInscrito.slug}`} textoCargando="Abriendo curso…">
              Ver el curso
            </Boton>
          </EstadoVacio>
        ) : (
          <EstadoVacio
            titulo="No encontramos esta clase"
            texto="Puede que el enlace esté mal escrito. En Mis cursos tienes el acceso a la última clase que viste."
            icono="buscar"
          >
            <Boton variante="principal" href="/mis-cursos" textoCargando="Abriendo…">
              Ir a Mis cursos
            </Boton>
          </EstadoVacio>
        )}
      </Tarjeta>
    )
  }

  {
    vista && (
      <div
        class="clase"
        data-clase
        data-clase-id={vista.clase.id}
        data-curso-id={vista.curso.id}
        data-completada={vista.completada ? '' : undefined}
        data-siguiente={vista.siguiente?.id}
        data-siguiente-texto={vista.siguiente ? `${vista.siguiente.codigo} ${vista.siguiente.titulo}` : undefined}
      >
        <div class="clase__principal">
          <nav aria-label="Ruta de navegación">
            <ol class="migas">
              <li><a href="/mis-cursos">Mis cursos</a></li>
              <li><a href={`/cursos/${vista.curso.slug}`}>{vista.curso.titulo}</a></li>
              <li><span aria-current="page">Módulo {vista.modulo.numero}</span></li>
            </ol>
          </nav>

          <div class="video">
            <video controls preload="metadata" playsinline crossorigin="anonymous" aria-label={`Video de la clase ${vista.clase.codigo}: ${vista.clase.titulo}`}>
              <source src={vista.video.src} type={vista.video.tipo} />
              <track kind="captions" src={vista.video.subtitulos} srclang="es" label="Español" default />
              Tu navegador no puede reproducir este video. Descarga la guía de la clase para seguirla.
            </video>
          </div>
          <p class="video__nota">
            <Icono nombre="subtitulos" tamano={18} />
            Subtítulos en español activados. Puedes apagarlos con el botón de subtítulos del reproductor.
          </p>

          <header class="clase__encabezado">
            <p class="clase__ceja">Módulo {vista.modulo.numero}, clase {vista.clase.codigo}</p>
            <h1 class="clase__titulo" tabindex="-1" data-titulo-pagina>{vista.clase.titulo}</h1>
            <p class="clase__descripcion">{vista.clase.descripcion}</p>
          </header>

          <section aria-labelledby="materiales-titulo">
            <h2 class="solo-lector" id="materiales-titulo">Materiales de la clase</h2>
            <ul class="materiales">
              {vista.materiales.map((m) => (
                <li>
                  <a class="material" href={m.url} download>
                    <span class:list={['material__tipo', `material__tipo--${m.tipo.toLowerCase()}`]}>{m.tipo}</span>
                    <span class="material__textos">
                      <span class="material__nombre">{m.nombre}</span>
                      <span class="material__detalle">{m.detalle} · descarga {m.tipo}</span>
                    </span>
                    <Icono nombre="descargar" tamano={22} class="material__icono" />
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <div class="clase__acciones">
            {vista.anterior ? (
              <BotonMultimodal variante="secundario" href={`/clase/${vista.anterior.id}`} modo="toque" textoCargando="Abriendo clase…">
                <Icono nombre="flecha-izq" tamano={18} />
                Clase anterior
              </BotonMultimodal>
            ) : (
              <span />
            )}

            <div class="clase__avanzar">
              <p class="clase__hecha" data-hecha hidden>
                <Badge tono="verde">Clase completada</Badge>
              </p>
              <span data-completar-caja hidden={vista.completada}>
                <BotonMultimodal
                  variante="principal"
                  modo="completo"
                  textoCargando="Guardando…"
                  textoExito="¡Completada!"
                  anuncioExito="Clase marcada como completada. Tu avance se guardó."
                  data-completar
                >
                  <Icono nombre="check" tamano={18} />
                  Marcar como completada
                </BotonMultimodal>
              </span>
              <span data-seguir-caja hidden>
                <BotonMultimodal variante="principal" href="#" modo="toque" textoCargando="Abriendo…" data-seguir>
                  <span data-seguir-texto>Siguiente clase</span>
                  <Icono nombre="flecha-der" tamano={18} />
                </BotonMultimodal>
              </span>
            </div>
          </div>
          <p class="aviso aviso--error" role="alert" data-completar-error hidden>
            <Icono nombre="alerta" />
            <span data-completar-error-texto />
          </p>
        </div>

        <aside class="clase__lateral" aria-label="Avance y contenido del curso">
          <div class="progreso-curso" data-progreso aria-busy="true">
            <p class="progreso-curso__fila">
              <span class="progreso-curso__etiqueta">Progreso del curso</span>
              <span class="progreso-curso__valor" data-progreso-texto>
                <span class="skeleton sk sk--valor" aria-hidden="true" />
              </span>
            </p>
            <span class="progreso" aria-hidden="true"><span class="progreso__avance" data-progreso-barra /></span>
          </div>

          <section class="indice" aria-labelledby="indice-titulo" data-indice aria-busy="true">
            <header class="indice__cabecera">
              <h2 class="indice__titulo" id="indice-titulo" tabindex="-1">Contenido del curso</h2>
              <p class="indice__resumen" data-indice-resumen />
            </header>
            <div class="indice__esqueleto" data-indice-cargando aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <span class="skeleton sk sk--fila" />)}
            </div>
            <div class="indice__lista" data-indice-lista hidden />
            <div class="indice__error" data-indice-error hidden>
              <EstadoParcial texto="El video y tu avance funcionan; el índice aparecerá al reconectar." multimodal />
            </div>
          </section>
        </aside>

        <p class="solo-lector" aria-live="polite" data-anuncio-clase />

        <template data-plantilla="ic-check"><Icono nombre="check" tamano={16} /></template>
        <template data-plantilla="ic-candado"><Icono nombre="candado" tamano={20} /></template>
        <template data-plantilla="ic-portapapeles"><Icono nombre="portapapeles" tamano={20} /></template>
        <template data-plantilla="ic-chevron"><Icono nombre="chevron" tamano={20} /></template>
      </div>
    )
  }
</App>

<script>
  import '../../scripts/clase';
  import '../../scripts/reintentar-pagina';
</script>

<style>
  .clase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: var(--e6);
    align-items: start;
  }
  .clase__principal {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
    min-width: 0;
  }

  /* Migas */
  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e1) var(--e2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .migas li {
    display: inline-flex;
    align-items: center;
    gap: var(--e2);
  }
  .migas li + li::before {
    content: '›';
    color: var(--ink3);
  }
  .migas a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink2);
    font-weight: 500;
  }
  .migas [aria-current] {
    font-weight: 700;
  }

  /* Video */
  .video {
    overflow: hidden;
    border-radius: var(--radio-tarjeta);
    background: var(--indigo);
    aspect-ratio: 16 / 9;
  }
  .video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--indigo);
  }
  .video video::cue {
    background: rgb(13 11 40 / 0.85);
    color: #fff;
    font-family: var(--fuente);
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .video__nota {
    display: flex;
    align-items: center;
    gap: var(--e2);
    margin-top: calc(-1 * var(--e2));
    color: var(--ink2);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
  }

  .clase__encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .clase__ceja {
    color: var(--indigo3);
    font-weight: 700;
  }
  .clase__titulo {
    font-size: 2.5rem;
    line-height: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    outline: none;
  }
  .clase__descripcion {
    max-width: 70ch;
    font-size: 1.125rem;
    line-height: 1.75rem;
    color: var(--ink2);
  }

  /* Materiales */
  .materiales {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .material {
    display: flex;
    align-items: center;
    gap: var(--e3);
    min-height: 88px;
    padding: var(--e3);
    border-radius: var(--radio-tarjeta);
    background: var(--white);
    color: var(--ink);
    transition:
      transform var(--t-rapido) ease-out,
      box-shadow 120ms ease-out;
  }
  .material:hover {
    text-decoration: none;
    transform: scale(1.02);
    box-shadow: var(--sombra-2);
  }
  .material:active {
    transform: scale(0.97);
    box-shadow: var(--sombra-1);
    transition-duration: 40ms;
  }
  .material__tipo {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radio-control);
    font-size: var(--t-pequeno);
    font-weight: 800;
  }
  .material__tipo--pdf { background: var(--lila); color: var(--indigo); }
  .material__tipo--txt { background: var(--mint); color: var(--grn); }
  .material__textos {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .material__nombre {
    font-weight: 700;
  }
  .material__detalle {
    color: var(--ink2);
    font-size: var(--t-pequeno);
    font-weight: 500;
  }
  .material :global(.material__icono) {
    flex: none;
    color: var(--indigo3);
  }

  /* Navegación entre clases */
  .clase__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    padding-top: var(--e3);
  }
  .clase__avanzar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--e3);
  }
  .clase__avanzar [hidden],
  .clase__hecha[hidden] {
    display: none;
  }

  /* Lateral: progreso + índice */
  .clase__lateral {
    position: sticky;
    top: var(--e4);
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }
  .progreso-curso {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .progreso-curso__fila {
    display: flex;
    justify-content: space-between;
    gap: var(--e2);
  }
  .progreso-curso__etiqueta {
    color: var(--ink2);
  }
  .progreso-curso__valor {
    font-weight: 700;
  }
  .indice {
    overflow: hidden;
    border-radius: var(--radio-tarjeta);
    background: var(--white);
  }
  .indice__cabecera {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding: var(--e4) var(--e4) var(--e3);
  }
  .indice__titulo {
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    font-weight: 800;
    outline: none;
  }
  .indice__resumen {
    color: var(--ink2);
  }
  .indice__esqueleto,
  .indice__lista {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding: 0 var(--e3) var(--e3);
  }
  .indice__esqueleto[hidden],
  .indice__lista[hidden],
  .indice__error[hidden] {
    display: none;
  }
  .indice__error {
    margin: 0 var(--e3) var(--e3);
    padding: var(--e3);
    border-radius: var(--radio-tarjeta);
    background: var(--paper);
  }
  .sk { display: block; }
  .sk--fila { height: 44px; }
  .sk--valor { display: inline-block; width: 150px; height: 20px; vertical-align: middle; }

  /* Filas del índice (las pinta el script) */
  .indice :global(.modulo-i) {
    border-radius: var(--radio-control);
  }
  .indice :global(.modulo-i__resumen) {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: var(--e2) var(--e3);
    border-radius: var(--radio-control);
    list-style: none;
    cursor: pointer;
    font-weight: 600;
  }
  .indice :global(.modulo-i__resumen::-webkit-details-marker) {
    display: none;
  }
  .indice :global(.modulo-i__resumen:hover) {
    background: var(--paper);
  }
  .indice :global(.modulo-i__estado) {
    color: var(--grn);
    font-size: var(--t-pequeno);
    font-weight: 600;
  }
  .indice :global(.modulo-i[open] > .modulo-i__resumen) {
    color: var(--indigo3);
  }
  .indice :global(.modulo-i__clases) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 0 var(--e2);
    list-style: none;
  }
  .indice :global(.marca) {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px var(--ink3);
  }
  .indice :global(.marca--hecha) {
    box-shadow: inset 0 0 0 2px var(--grn);
    color: var(--grn);
  }
  .indice :global(.marca--actual) {
    background: var(--yellow);
    box-shadow: none;
  }
  .indice :global(.marca--actual::after) {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }
  .indice :global(.clase-i) {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: var(--e2) var(--e3);
    border-radius: var(--radio-control);
    color: var(--ink);
    font-weight: 500;
    transition: background-color var(--t-rapido) ease-out;
  }
  .indice :global(.clase-i:hover) {
    background: var(--paper);
    text-decoration: none;
  }
  .indice :global(.clase-i[aria-current='page']) {
    background: var(--indigo);
    color: var(--white);
    font-weight: 700;
  }
  .indice :global(.clase-i__titulo) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .indice :global(.clase-i__min) {
    color: var(--ink2);
    font-size: var(--t-pequeno);
  }
  .indice :global(.clase-i[aria-current='page'] .clase-i__min) {
    color: rgb(255 255 255 / 0.85);
  }
  .indice :global(.evaluacion-i) {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    margin-top: var(--e2);
    padding: var(--e3);
    border-radius: var(--radio-control);
    background: var(--paper);
    color: var(--ink);
  }
  .indice :global(a.evaluacion-i) {
    background: var(--mint);
    transition: transform var(--t-rapido) ease-out;
  }
  .indice :global(a.evaluacion-i:hover) {
    text-decoration: none;
    transform: scale(1.02);
  }
  .indice :global(.evaluacion-i__titulo) {
    display: block;
    font-weight: 700;
  }
  .indice :global(.evaluacion-i__texto) {
    display: block;
    color: var(--ink2);
    font-size: var(--t-pequeno);
    font-weight: 500;
  }

  @media (max-width: 1199px) {
    .clase {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: var(--e5);
    }
  }
  @media (max-width: 999px) {
    .clase {
      grid-template-columns: minmax(0, 1fr);
    }
    .clase__lateral {
      position: static;
    }
  }
  @media (max-width: 599px) {
    .clase__titulo {
      font-size: var(--t-h1);
      line-height: var(--lh-h1);
    }
    .materiales {
      grid-template-columns: minmax(0, 1fr);
    }
    .clase__acciones,
    .clase__avanzar {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .clase__acciones :global(.boton) {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .material:hover,
    .material:active {
      transform: none;
    }
  }
</style>
