---
// Solo desarrollo: los 5 estados (UI Stack) de Iniciar sesión, Crear cuenta e Inicio, lado a lado.
// Cada vista es un iframe de la pantalla real con ?simular=… (el middleware da 404 en producción).
// Elegir pantalla: /estados?p=login | registro | inicio | multimodal
// "Multimodal" (Act. 12) no es una pantalla: muestra el BotonMultimodal en éxito y error
// y la tabla de qué canal se activa en cada momento (para la exposición).
import Publico from '../layouts/Publico.astro';
import BotonMultimodal from '../components/BotonMultimodal.astro';
import InterruptorSonido from '../components/InterruptorSonido.astro';
import Icono from '../components/Icono.astro';
import Badge from '../components/Badge.astro';

if (!import.meta.env.DEV) return new Response('No encontrado', { status: 404 });

interface Estado {
  n: number;
  nombre: string;
  simular: string;
  texto: string;
  variantes?: { simular: string; nombre: string }[];
}

const PANTALLAS: Record<string, { titulo: string; ruta: string; estados: Estado[] }> = {
  login: {
    titulo: 'Iniciar sesión',
    ruta: '/login',
    estados: [
      { n: 1, nombre: 'Ideal', simular: 'ideal', texto: 'Correo recordado con "Sugerido"; el foco ya está en la contraseña.' },
      { n: 2, nombre: 'Vacío', simular: 'vacio', texto: 'Primera vez en este dispositivo: sin correo recordado y con "Crea una gratis" a la vista.' },
      { n: 3, nombre: 'Cargando', simular: 'cargando', texto: '"Ingresando…" con giro, micro barra y campos deshabilitados.' },
      {
        n: 4,
        nombre: 'Error',
        simular: 'error-credenciales',
        texto: 'Qué pasó y cómo salir. Cambia la variante abajo.',
        variantes: [
          { simular: 'error-credenciales', nombre: 'Credenciales' },
          { simular: 'error-red', nombre: 'Sin conexión' },
          { simular: 'bloqueo', nombre: 'Bloqueo' },
        ],
      },
      { n: 5, nombre: 'Parcial', simular: 'parcial', texto: '"Esta semana" no cargó; el formulario sigue funcionando.' },
    ],
  },
  registro: {
    titulo: 'Crear cuenta',
    ruta: '/registro',
    estados: [
      { n: 1, nombre: 'Ideal', simular: 'ideal', texto: 'Todo válido: requisitos en verde, seguridad "fuerte" y el botón habilitado.' },
      { n: 2, nombre: 'Vacío', simular: 'vacio', texto: 'Formulario en blanco; el botón explica todo lo que falta.' },
      { n: 3, nombre: 'Cargando', simular: 'cargando', texto: '"Creando tu cuenta…" con giro, micro barra y campos deshabilitados.' },
      { n: 4, nombre: 'Error', simular: 'error-red', texto: 'Sin conexión: aviso con "Reintentar"; los datos escritos se conservan.' },
      { n: 5, nombre: 'Parcial', simular: 'parcial', texto: '"Esta semana" no cargó; se puede crear la cuenta igual.' },
    ],
  },
  inicio: {
    titulo: 'Inicio del estudiante',
    ruta: '/inicio',
    estados: [
      { n: 1, nombre: 'Ideal', simular: 'ideal', texto: 'Continúa donde te quedaste, próximo certificado, Esta semana y otros cursos.' },
      { n: 2, nombre: 'Vacío', simular: 'vacio', texto: 'Estudiante nuevo sin cursos: una sola acción, "Explorar cursos".' },
      { n: 3, nombre: 'Cargando', simular: 'cargando', texto: 'Skeleton en cada tarjeta mientras llegan los datos.' },
      { n: 4, nombre: 'Error', simular: 'error', texto: 'No cargó lo principal: qué pasó + "Reintentar".' },
      { n: 5, nombre: 'Parcial', simular: 'parcial', texto: 'Lo de arriba cargó; "Esta semana" dice "No se pudo cargar esta parte" + "Reconectar".' },
    ],
  },
};

const pedida = Astro.url.searchParams.get('p') ?? 'login';
const multimodal = pedida === 'multimodal';
const clave = multimodal || PANTALLAS[pedida] ? pedida : 'login';
const actual = PANTALLAS[clave] ?? PANTALLAS.login;

// Qué canal se activa en cada momento (redundancia sensorial).
const CANALES = [
  {
    momento: 'Presionar',
    tiempo: '< 50 ms',
    visual: 'Se hunde a 97 % con sombra interior; al soltar rebota',
    auditivo: '—',
    haptico: '10 ms',
    lector: 'Nombre y función: “Publicar curso, botón”',
  },
  {
    momento: 'Procesando',
    tiempo: '50 ms',
    visual: 'Giro + micro barra + “Publicando…”',
    auditivo: '—',
    haptico: '—',
    lector: 'aria-busy="true" y aria-disabled="true"',
  },
  {
    momento: 'Éxito',
    tiempo: '~200 ms (con el resultado)',
    visual: 'Verde con check y rebote elástico',
    auditivo: '2 notas ascendentes (Do5 → Sol5), ~250 ms',
    haptico: '[30, 50, 30]',
    lector: 'aria-live="polite": “Curso publicado”',
  },
  {
    momento: 'Error',
    tiempo: '~200 ms (con el resultado)',
    visual: 'Sacudida corta (con movimiento reducido: se tiñe de rojo)',
    auditivo: '2 notas graves descendentes (La3 → Mi3), ~270 ms',
    haptico: '[80, 40, 80]',
    lector: 'aria-live="assertive": qué pasó y qué hacer',
  },
];
---

<Publico titulo="Estados (desarrollo)">
  <span slot="cabecera" class="nota terciario">Solo en desarrollo</span>
  <main class="contenido">
    <header class="intro">
      <p class="pequeno marca">AulaViva · UI Stack</p>
      {
        multimodal ? (
          <>
            <h1 class="h1">Redundancia sensorial (Act. 12)</h1>
            <p class="secundario">
              BotonMultimodal: una sola función, retroalimentar(), dispara a la vez la respuesta visual, auditiva, háptica y para lector
              de pantalla.
            </p>
          </>
        ) : (
          <>
            <h1 class="h1">Los 5 estados de {actual.titulo}</h1>
            <p class="secundario">Cada vista es la pantalla real con un estado forzado. Desplázate a los lados para verlas todas.</p>
          </>
        )
      }
      <nav class="pantallas" aria-label="Pantalla">
        {
          Object.entries(PANTALLAS).map(([id, p]) => (
            <a href={`/estados?p=${id}`} class="variante" aria-current={id === clave ? 'page' : undefined}>
              {p.titulo}
            </a>
          ))
        }
        <a href="/estados?p=multimodal" class="variante" aria-current={multimodal ? 'page' : undefined}>Multimodal</a>
      </nav>
    </header>

    {
      multimodal && (
        <div class="mm">
          <section class="mm__bloque" aria-labelledby="mm-demo-titulo">
            <div class="mm__cabeza">
              <h2 class="h2" id="mm-demo-titulo">Pruébalo</h2>
              <InterruptorSonido />
            </div>
            <p class="secundario pequeno">
              Con el ratón, con el teclado (Tab y luego Enter o Espacio) o con el dedo en un celular Android para sentir la vibración.
            </p>
            <div class="mm__botones">
              <div class="mm__caso">
                <Badge tono="verde">Éxito</Badge>
                <BotonMultimodal
                  variante="principal"
                  textoCargando="Publicando…"
                  textoExito="¡Publicado!"
                  anuncioExito="Curso publicado."
                  data-demo="exito"
                >
                  <Icono nombre="check" tamano={18} />
                  Publicar curso
                </BotonMultimodal>
              </div>
              <div class="mm__caso">
                <Badge tono="rojo">Error</Badge>
                <BotonMultimodal
                  variante="secundario"
                  textoCargando="Guardando…"
                  anuncioError="No se pudo guardar. Revisa tu conexión y vuelve a intentarlo."
                  data-demo="error"
                >
                  <Icono nombre="guardar" tamano={18} />
                  Guardar
                </BotonMultimodal>
              </div>
              <div class="mm__caso">
                <Badge tono="neutro">Solo toque</Badge>
                <BotonMultimodal variante="secundario" modo="toque" data-demo="toque">
                  Siguiente
                  <Icono nombre="flecha-der" tamano={18} />
                </BotonMultimodal>
              </div>
            </div>
            <p class="nota terciario" data-demo-registro aria-hidden="true">Pulsa un botón para ver cuándo se activó cada canal.</p>
          </section>

          <section class="mm__bloque" aria-labelledby="mm-tabla-titulo">
            <h2 class="h2" id="mm-tabla-titulo">Qué canal se activa y cuándo</h2>
            <div class="tabla-envoltura" tabindex="0" role="region" aria-labelledby="mm-tabla-titulo">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Momento</th>
                    <th scope="col">Tiempo</th>
                    <th scope="col">Visual</th>
                    <th scope="col">Auditivo</th>
                    <th scope="col">Háptico</th>
                    <th scope="col">Lector de pantalla</th>
                  </tr>
                </thead>
                <tbody>
                  {CANALES.map((c) => (
                    <tr>
                      <th scope="row">{c.momento}</th>
                      <td>{c.tiempo}</td>
                      <td>{c.visual}</td>
                      <td>{c.auditivo}</td>
                      <td>{c.haptico}</td>
                      <td>{c.lector}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <ul class="mm__notas secundario pequeno">
              <li>
                Éxito y error llegan en la <strong>misma llamada</strong>: retroalimentar(boton, tipo) en src/scripts/multimodal.ts.
              </li>
              <li>
                El sonido solo ocurre tras una acción del usuario y se apaga con “Sonido y vibración” (WCAG 1.4.2). Se recuerda en este
                dispositivo para todas las páginas.
              </li>
              <li>Si el dispositivo no vibra (escritorio, iPhone), los otros tres canales siguen igual.</li>
              <li>
                Modos: <strong>toque</strong> (Siguiente, Anterior, Continuar clase), <strong>éxito suave</strong> (Guardar borrador) y
                <strong>completo</strong> (Iniciar sesión, Crear cuenta, Publicar curso, Reintentar, Reconectar).
              </li>
            </ul>
          </section>
        </div>
      )
    }

    <div class="tira" hidden={multimodal}>
      {
        actual.estados.map((e) => (
          <article class="estado">
            <div class="marco">
              <iframe
                src={`${actual.ruta}?simular=${e.simular}`}
                title={`Estado ${e.nombre} de ${actual.titulo}`}
                loading="lazy"
                tabindex="-1"
                data-marco={e.variantes ? 'variantes' : undefined}
              />
            </div>
            <div class="estado__pie">
              <h2 class="estado__titulo">
                <span class:list={['numero', e.n === 1 && 'numero--ideal']}>{e.n}</span>
                {e.nombre}
              </h2>
              <p class="secundario pequeno">{e.texto}</p>
              {e.variantes && (
                <div class="variantes" role="group" aria-label="Variante del error">
                  {e.variantes.map((v, i) => (
                    <button type="button" class="variante" aria-pressed={i === 0 ? 'true' : 'false'} data-variante={v.simular}>
                      {v.nombre}
                    </button>
                  ))}
                </div>
              )}
              <a
                class="pequeno"
                href={`${actual.ruta}?simular=${e.simular}`}
                target="_blank"
                data-abrir={e.variantes ? 'variantes' : undefined}
              >
                Abrir en grande
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </main>
</Publico>

<script>
  import { procesar, retroalimentar } from '../scripts/multimodal';
  import { estaOcupado, ponerEstado } from '../scripts/boton';

  // Demo multimodal: 350 ms "procesando" y luego éxito o error, con registro de tiempos.
  const registro = document.querySelector<HTMLElement>('[data-demo-registro]');
  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-demo]')) {
    let t0 = 0;
    boton.addEventListener('pointerdown', () => (t0 = performance.now()));
    boton.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') t0 = performance.now();
    });
    boton.addEventListener('click', async () => {
      if (estaOcupado(boton)) return;
      const inicio = t0 || performance.now();
      t0 = 0;
      const ms = () => Math.round(performance.now() - inicio);
      const tipo = boton.dataset.demo;
      if (tipo === 'toque') {
        if (registro) registro.textContent = 'Presionar: 0 ms → se hunde + vibración de 10 ms. Sin earcon: solo navega.';
        return;
      }
      procesar(boton);
      const tProcesando = ms();
      await new Promise((r) => setTimeout(r, 350));
      retroalimentar(boton, tipo === 'exito' ? 'exito' : 'error');
      if (registro) {
        registro.textContent = `Presionar: 0 ms · Procesando: ${tProcesando} ms · ${tipo === 'exito' ? 'Éxito' : 'Error'}: ${ms()} ms (visual, sonido, vibración y aviso en el mismo instante).`;
      }
      if (tipo === 'exito') setTimeout(() => ponerEstado(boton, 'normal'), 1500);
    });
  }

  const marco = document.querySelector<HTMLIFrameElement>('[data-marco="variantes"]');
  const abrir = document.querySelector<HTMLAnchorElement>('[data-abrir="variantes"]');
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-variante]')];
  for (const boton of botones) {
    boton.addEventListener('click', () => {
      if (!marco || !abrir) return;
      for (const b of botones) b.setAttribute('aria-pressed', String(b === boton));
      const url = new URL(marco.src);
      url.searchParams.set('simular', boton.dataset.variante!);
      marco.src = url.pathname + url.search;
      abrir.href = marco.src;
    });
  }
</script>

<style>
  .contenido {
    padding: var(--e5) var(--e5) var(--e6);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin-bottom: var(--e5);
  }
  .marca {
    color: var(--indigo3);
    font-weight: 700;
  }
  .pantallas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e2);
    margin-top: var(--e2);
  }
  .tira {
    display: flex;
    gap: var(--e4);
    overflow-x: auto;
    padding-bottom: var(--e3);
    scroll-snap-type: x mandatory;
  }
  .estado {
    flex: none;
    width: 432px;
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    scroll-snap-align: start;
  }
  /* La pantalla de escritorio (1440 × 900) reducida al 30 % */
  .marco {
    width: 432px;
    height: 270px;
    overflow: hidden;
    border-radius: var(--radio-tarjeta);
    background: var(--white);
  }
  .marco iframe {
    width: 1440px;
    height: 900px;
    border: 0;
    transform: scale(0.3);
    transform-origin: 0 0;
    pointer-events: none;
  }
  .estado__pie {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .estado__titulo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    font-weight: 800;
  }
  .numero {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--indigo-t);
    color: var(--indigo3);
    font-size: var(--t-cuerpo);
  }
  .numero--ideal {
    background: var(--yellow);
    color: var(--ink);
  }
  .variantes {
    display: flex;
    gap: var(--e2);
    flex-wrap: wrap;
  }
  .variante {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: var(--white);
    color: var(--ink2);
    font-size: var(--t-pequeno);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .variante:hover {
    text-decoration: none;
  }
  .variante[aria-pressed='true'],
  .variante[aria-current='page'] {
    background: var(--indigo-t);
    color: var(--indigo3);
  }
  /* ─── Multimodal ─────────────────────────────── */
  .tira[hidden] {
    display: none;
  }
  .mm {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }
  .mm__bloque {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    padding: var(--e4);
    border-radius: var(--radio-tarjeta);
    background: var(--white);
  }
  .mm__bloque :global(.interruptor--claro) {
    background: var(--paper);
  }
  .mm__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--e3);
  }
  .mm__botones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e3);
  }
  .mm__caso {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--e2);
    padding: var(--e3);
    border-radius: var(--radio-tarjeta);
    background: var(--paper);
  }
  .tabla-envoltura {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0 var(--e1);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    text-align: left;
  }
  thead th {
    padding: 0 var(--e3) var(--e1);
    color: var(--ink2);
    font-weight: 600;
  }
  tbody th,
  tbody td {
    padding: 12px var(--e3);
    background: var(--paper);
    vertical-align: top;
  }
  tbody th {
    font-weight: 700;
    border-radius: var(--radio-control) 0 0 var(--radio-control);
  }
  tbody td:last-child {
    border-radius: 0 var(--radio-control) var(--radio-control) 0;
  }
  .mm__notas {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    padding-left: var(--e4);
  }
  @media (max-width: 600px) {
    .contenido {
      padding: var(--e4) var(--e3);
    }
  }
</style>
