---
// Crear curso en 4 pasos · referencias/pantallas/admin-01 a admin-04 (solo rol admin).
// Chunking: un paso por tarea y máximo 6 campos a la vista en cada uno.
// Los editores de módulo, clase y pregunta existen UNA sola vez y se mueven al elemento
// abierto (solo una clase o pregunta abierta a la vez). Lógica: src/scripts/crear-curso.ts.
import Admin from '../../../layouts/Admin.astro';
import Topbar from '../../../components/Topbar.astro';
import Tarjeta from '../../../components/Tarjeta.astro';
import Stepper from '../../../components/Stepper.astro';
import Campo from '../../../components/Campo.astro';
import Boton from '../../../components/Boton.astro';
import BotonMultimodal from '../../../components/BotonMultimodal.astro';
import Badge from '../../../components/Badge.astro';
import Modal from '../../../components/Modal.astro';
import Icono, { type NombreIcono } from '../../../components/Icono.astro';
import { listarInstructores, ultimoInstructor } from '../../../lib/repositorio';
import { CATEGORIAS, NIVELES, LIMITES, hoyEnLima, type CategoriaId } from '../../../lib/validacion-curso';

const instructores = await listarInstructores();
const sugeridoInstructor = await ultimoInstructor();
const hoy = hoyEnLima();

const ICONOS_CATEGORIA: Record<CategoriaId, NombreIcono> = {
  tecnologia: 'codigo',
  diseno: 'pluma',
  negocios: 'grafico',
  'habilidades-blandas': 'chat',
};
const PASOS = ['Datos generales', 'Contenido', 'Evaluación', 'Revisar y publicar'];
const SUBIDAS = [
  { tipo: 'video', etiqueta: 'Video', texto: 'Subir video', accept: '.mp4,.webm,.mov,video/*' },
  { tipo: 'subtitulos', etiqueta: 'Subtítulos (.vtt)', texto: 'Subir subtítulos', accept: '.vtt,text/vtt' },
  { tipo: 'documento', etiqueta: 'Documento', texto: 'Subir documento', accept: '.pdf,.docx,.pptx' },
];
---

<Admin titulo="Crear curso" activo="cursos">
  <Topbar titulo="Crear curso">
    <nav slot="migas" class="migas" aria-label="Ruta">
      <a href="/admin/cursos">Cursos</a>
      <Icono nombre="chevron" tamano={16} class="migas__flecha" />
      <span aria-current="page" data-miga>Crear curso · Datos generales</span>
    </nav>
    <Badge slot="acciones" tono="neutro" icono="guardar" data-estado-borrador>Borrador sin guardar</Badge>
  </Topbar>

  <Tarjeta como="div" class="crear__stepper">
    <Stepper pasos={PASOS} actual={1} />
  </Tarjeta>

  <div
    class="crear"
    data-crear
    data-hoy={hoy}
    data-instructor-sugerido={sugeridoInstructor}
    data-instructores={JSON.stringify(instructores)}
  >
    <form class="crear__form" novalidate data-form-curso>
      <Tarjeta como="div" class="crear__tarjeta">
        <div class="aviso aviso--info aviso-borrador" data-aviso-borrador hidden>
          <Icono nombre="info" />
          <p data-aviso-borrador-texto></p>
          <button type="button" class="enlace" data-aviso-borrador-accion></button>
        </div>

        <!-- ═══ Paso 1 · Datos generales ═══ -->
        <section class="paso" data-paso="1" aria-labelledby="paso-1-titulo">
          <div class="paso__encabezado">
            <p class="ceja">Paso 1 de 4</p>
            <h2 class="h2" id="paso-1-titulo" tabindex="-1">Datos generales</h2>
            <p class="secundario">Lo que verá el estudiante en el catálogo.</p>
          </div>

          <Campo id="titulo" etiqueta="Título del curso" maxlength={LIMITES.titulo} placeholder="Ej.: Diseño de interfaces con Figma" data-ruta="titulo" />

          <Campo id="descripcion" como="textarea" rows={3} etiqueta="Descripción" maxlength={LIMITES.descripcion} placeholder="En una o dos frases: qué aprenderá el estudiante." data-ruta="descripcion">
            <span slot="extra" class="nota terciario" data-contador>0 / {LIMITES.descripcion}</span>
          </Campo>

          <fieldset class="grupo" data-campo aria-describedby="categoria-ayuda categoria-error">
            <legend class="grupo__etiqueta">Categoría</legend>
            <div class="categorias">
              {
                CATEGORIAS.map((c) => (
                  <label class="categoria">
                    <input type="radio" name="categoria" value={c.id} class="solo-lector" data-ruta="categoria" />
                    <Icono nombre={ICONOS_CATEGORIA[c.id]} tamano={24} />
                    <span>{c.texto}</span>
                  </label>
                ))
              }
            </div>
            <p class="ayuda" id="categoria-ayuda">4 categorías principales; los temas se buscan después escribiendo.</p>
            <p class="error-grupo" id="categoria-error" aria-live="polite"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
          </fieldset>

          <div class="fila fila--2">
            <Campo como="select" id="nivel" etiqueta="Nivel" data-ruta="nivel">
              {NIVELES.map((n) => <option value={n.id}>{n.texto}</option>)}
            </Campo>
            <Campo id="horas" type="number" inputmode="numeric" min={LIMITES.horas[0]} max={LIMITES.horas[1]} etiqueta="Horas académicas" placeholder="Ej.: 24" ayuda="Aparecen en el certificado." data-ruta="horas" />
          </div>

          <div class="grupo" data-campo>
            <span class="grupo__etiqueta" id="imagen-etiqueta">Imagen de portada</span>
            <label class="subida subida--ancha" data-subida="imagen">
              <input type="file" id="imagen" class="solo-lector" accept=".jpg,.jpeg,.png,image/jpeg,image/png" aria-labelledby="imagen-etiqueta imagen-texto" aria-describedby="imagen-error" data-archivo="imagen" data-ruta="imagen" />
              <Icono nombre="subir" />
              <span id="imagen-texto" data-subida-texto>Subir imagen (JPG o PNG)</span>
            </label>
            <p class="error-grupo" id="imagen-error" aria-live="polite"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
          </div>
        </section>

        <!-- ═══ Paso 2 · Contenido ═══ -->
        <section class="paso" data-paso="2" aria-labelledby="paso-2-titulo" hidden>
          <div class="paso__encabezado">
            <p class="ceja">Paso 2 de 4</p>
            <h2 class="h2" id="paso-2-titulo" tabindex="-1">Contenido</h2>
            <p class="secundario">Ordena los módulos y sus clases. Abre solo la clase que estás editando.</p>
          </div>
          <p class="error-grupo error-grupo--suelto" aria-live="polite" data-error-general="modulos"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
          <ol class="modulos" aria-label="Módulos del curso" data-modulos></ol>
          <div>
            <Boton variante="secundario" data-agregar-modulo>
              <Icono nombre="mas" tamano={18} />
              Agregar módulo
            </Boton>
          </div>
        </section>

        <!-- ═══ Paso 3 · Evaluación ═══ -->
        <section class="paso" data-paso="3" aria-labelledby="paso-3-titulo" hidden>
          <div class="paso__encabezado">
            <p class="ceja">Paso 3 de 4</p>
            <h2 class="h2" id="paso-3-titulo" tabindex="-1">Evaluación</h2>
            <p class="secundario">Configura cómo se aprueba y escribe las preguntas una por una.</p>
          </div>

          <div class="region reglas" data-reglas>
            <div class="reglas__resumen">
              <div>
                <p class="reglas__titulo">
                  Reglas de aprobación
                  <Badge tono="sugerido" data-reglas-sugerido>Sugerido</Badge>
                </p>
                <p class="secundario" data-reglas-texto>Nota mínima 14 de 20 · 3 intentos · 30 minutos</p>
              </div>
              <button type="button" class="enlace" aria-expanded="false" aria-controls="reglas-campos" data-cambiar-reglas>Cambiar</button>
            </div>
            <div class="fila fila--3" id="reglas-campos" data-reglas-campos hidden>
              <Campo id="nota" type="number" inputmode="numeric" min={LIMITES.nota[0]} max={LIMITES.nota[1]} etiqueta="Nota mínima" ayuda="Sobre 20." sobreGris data-ruta="evaluacion.notaMinima" />
              <Campo id="intentos" type="number" inputmode="numeric" min={LIMITES.intentos[0]} max={LIMITES.intentos[1]} etiqueta="Intentos permitidos" ayuda="Vale el mejor intento." sobreGris data-ruta="evaluacion.intentos" />
              <Campo id="tiempo" type="number" inputmode="numeric" min={LIMITES.tiempo[0]} max={LIMITES.tiempo[1]} etiqueta="Tiempo límite (min)" ayuda="Por intento." sobreGris data-ruta="evaluacion.tiempoMin" />
            </div>
          </div>

          <p class="error-grupo error-grupo--suelto" aria-live="polite" data-error-general="evaluacion.preguntas"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
          <ol class="preguntas" aria-label="Preguntas de la evaluación" data-preguntas></ol>
          <div>
            <Boton variante="secundario" data-agregar-pregunta>
              <Icono nombre="mas" tamano={18} />
              Agregar pregunta
            </Boton>
          </div>
        </section>

        <!-- ═══ Paso 4 · Revisar y publicar ═══ -->
        <section class="paso" data-paso="4" aria-labelledby="paso-4-titulo" hidden>
          <div class="paso__encabezado">
            <p class="ceja">Paso 4 de 4</p>
            <h2 class="h2" id="paso-4-titulo" tabindex="-1">Revisar y publicar</h2>
            <p class="secundario">Llenamos lo que ya sabemos. Solo confirma.</p>
          </div>

          <ul class="resumen" aria-label="Resumen del curso">
            {
              ['Datos generales', 'Contenido', 'Evaluación'].map((titulo, i) => (
                <li class="resumen__fila" data-resumen={i + 1} data-ok="true">
                  <span class="resumen__icono" aria-hidden="true">
                    <Icono nombre="check" tamano={20} class="resumen__check" />
                    <Icono nombre="alerta" tamano={20} class="resumen__alerta" />
                  </span>
                  <div class="resumen__textos">
                    <p class="resumen__titulo">{titulo}</p>
                    <p class="secundario" data-resumen-texto></p>
                  </div>
                  <button type="button" class="enlace resumen__editar" data-editar={i + 1} aria-label={`Editar ${titulo.toLowerCase()}`}>Editar</button>
                </li>
              ))
            }
          </ul>

          <div class="fila fila--3 sugeridos">
            <Campo id="instructor" etiqueta="Instructor" list="lista-instructores" autocomplete="off" maxlength={LIMITES.instructor} ayuda="Escribe para buscar. Sugerimos tu último instructor." data-ruta="instructor">
              <span slot="extra" data-sugerido="instructor"><Badge tono="sugerido">Sugerido</Badge></span>
              <span slot="antes" class="avatar-mini" aria-hidden="true" data-avatar-instructor></span>
            </Campo>
            <Campo id="requisitos" etiqueta="Requisitos previos" maxlength={LIMITES.requisitos} ayuda="El más usado en cursos de este nivel." data-ruta="requisitos">
              <span slot="extra" data-sugerido="requisitos"><Badge tono="sugerido">Sugerido</Badge></span>
            </Campo>
            <Campo id="fecha" type="date" min={hoy} etiqueta="Fecha de publicación" ayuda="Se llena con la fecha actual." data-ruta="fechaPublicacion">
              <span slot="extra" data-sugerido="fechaPublicacion"><Badge tono="sugerido">Sugerido</Badge></span>
            </Campo>
          </div>
          <datalist id="lista-instructores">
            {instructores.map((nombre) => <option value={nombre} />)}
          </datalist>

          <p class="aviso aviso--error" data-error-media hidden><Icono nombre="alerta" /><span data-error-media-texto></span></p>
          <p class="aviso aviso--advertencia">
            <Icono nombre="alerta" />
            <span>Al publicar, el curso aparecerá en el catálogo. Si después tiene inscritos, no se podrá eliminar, solo deshabilitar.</span>
          </p>
          <div class="aviso aviso--error aviso-red" data-aviso-red hidden>
            <Icono nombre="sin-conexion" />
            <div class="aviso-red__texto">
              <p class="aviso__titulo" data-aviso-red-titulo>Sin conexión a internet</p>
              <p data-aviso-red-detalle>El curso no se publicó. Tu trabajo sigue aquí; inténtalo de nuevo.</p>
            </div>
            <Boton variante="secundario" data-reintentar textoCargando="Reintentando…">
              <Icono nombre="reintentar" tamano={18} />
              Reintentar
            </Boton>
          </div>
        </section>

        <!-- ═══ Publicado (éxito) ═══ -->
        <section class="publicado" data-publicado hidden aria-labelledby="publicado-titulo">
          <span class="publicado__icono"><Icono nombre="check" tamano={32} /></span>
          <h2 class="h2" id="publicado-titulo" tabindex="-1">Curso publicado</h2>
          <p class="secundario" data-publicado-texto></p>
          <Boton variante="principal" href="/admin/cursos/nuevo" textoCargando="Abriendo…">
            <Icono nombre="mas" tamano={18} />
            Crear otro curso
          </Boton>
        </section>

        <!-- Avisos con "Deshacer" (quitar clase, módulo, pregunta o borrador) -->
        <div class="aviso aviso--info deshacer" data-deshacer hidden>
          <Icono nombre="info" />
          <p data-deshacer-texto></p>
          <button type="button" class="enlace" data-deshacer-boton>Deshacer</button>
        </div>

        <div class="pie" data-pie>
          <div class="pie__izq">
            <a class="enlace pie__cancelar" href="/admin/cursos" data-cancelar>Cancelar</a>
            <BotonMultimodal variante="secundario" modo="toque" data-anterior hidden>
              <Icono nombre="flecha-izq" tamano={18} />
              Anterior
            </BotonMultimodal>
          </div>
          <span class="pie__paso" data-pie-paso>Paso 1 de 4</span>
          <div class="pie__der">
            <BotonMultimodal
              variante="secundario"
              textoCargando="Guardando…"
              textoExito="Guardado"
              modo="exito-suave"
              anuncioExito="Borrador guardado en este dispositivo."
              data-guardar
            >
              <Icono nombre="guardar" tamano={18} />
              Guardar borrador
            </BotonMultimodal>
            <BotonMultimodal variante="principal" modo="toque" data-siguiente>
              <span data-siguiente-texto>Siguiente: Contenido</span>
              <Icono nombre="flecha-der" tamano={18} />
            </BotonMultimodal>
            <BotonMultimodal
              variante="principal"
              textoCargando="Publicando…"
              textoExito="¡Publicado!"
              modo="completo"
              anuncioExito="Curso publicado."
              data-publicar
              hidden
            >
              <Icono nombre="check" tamano={18} />
              Publicar curso
            </BotonMultimodal>
          </div>
        </div>
        <p class="solo-lector" aria-live="polite" data-anuncio></p>
      </Tarjeta>

      <!-- Editores únicos: se mueven al módulo, clase o pregunta abiertos -->
      <div hidden data-almacen>
        <div class="editor-modulo" data-editor-modulo>
          <Campo id="modulo-titulo" etiqueta="Título del módulo" maxlength={LIMITES.tituloModulo} placeholder="Ej.: Fundamentos del diseño de interfaces" sobreGris data-editor-campo="titulo" />
          <button type="button" class="enlace enlace--quitar" data-quitar-modulo>Quitar este módulo</button>
        </div>

        <div class="editor-clase" data-editor-clase>
          <div class="fila fila--clase">
            <Campo id="clase-titulo" etiqueta="Título de la clase" maxlength={LIMITES.tituloClase} placeholder="Ej.: ¿Qué es una interfaz?" data-editor-campo="titulo" />
            <Campo id="clase-duracion" type="number" inputmode="numeric" min={LIMITES.duracion[0]} max={LIMITES.duracion[1]} etiqueta="Duración (min)" placeholder="12" data-editor-campo="duracionMin" />
          </div>
          <div class="fila fila--3">
            {
              SUBIDAS.map((s) => (
                <div class="grupo" data-campo>
                  <span class="grupo__etiqueta" id={`clase-${s.tipo}-etiqueta`}>{s.etiqueta}</span>
                  <label class="subida" data-subida={s.tipo}>
                    <input
                      type="file"
                      id={`clase-${s.tipo}`}
                      class="solo-lector"
                      accept={s.accept}
                      aria-labelledby={`clase-${s.tipo}-etiqueta clase-${s.tipo}-texto`}
                      aria-describedby={`clase-${s.tipo}-error`}
                      data-archivo={s.tipo}
                      data-editor-campo={s.tipo}
                    />
                    <Icono nombre="subir" />
                    <span id={`clase-${s.tipo}-texto`} data-subida-texto>{s.texto}</span>
                  </label>
                  <p class="error-grupo" id={`clase-${s.tipo}-error`} aria-live="polite"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
                </div>
              ))
            }
          </div>
          <button type="button" class="enlace enlace--quitar" data-quitar-clase>Quitar esta clase</button>
        </div>

        <div class="editor-pregunta" data-editor-pregunta>
          <Campo id="pregunta-enunciado" como="textarea" rows={2} etiqueta="Enunciado" maxlength={LIMITES.enunciado} placeholder="Ej.: ¿Qué heurística pide mostrar siempre lo que está pasando?" sobreGris data-editor-campo="enunciado" />
          <fieldset class="grupo opciones" data-campo aria-describedby="opciones-error">
            <legend class="grupo__etiqueta">Opciones (marca la correcta)</legend>
            {
              [0, 1, 2, 3].map((k) => (
                <div class="opcion" data-opcion={k}>
                  <input type="radio" name="correcta" value={k} id={`correcta-${k}`} aria-label={`Marcar la opción ${'ABCD'[k]} como correcta`} data-correcta />
                  <label class="opcion__letra" for={`opcion-${k}`}>{'ABCD'[k]}</label>
                  <input type="text" id={`opcion-${k}`} class="opcion__texto" maxlength={LIMITES.opcion} placeholder={`Escribe la opción ${'ABCD'[k]}`} data-opcion-texto={k} />
                  <span class="opcion__correcta">Correcta</span>
                </div>
              ))
            }
            <p class="error-grupo" id="opciones-error" aria-live="polite"><Icono nombre="alerta" tamano={16} /><span data-mensaje></span></p>
          </fieldset>
          <button type="button" class="enlace enlace--quitar" data-quitar-pregunta>Quitar esta pregunta</button>
        </div>
      </div>
    </form>

    <aside class="crear__lado" aria-label="Ayuda del paso">
      <Tarjeta como="div" tono="oscura" class="ayuda-paso">
        <Icono nombre="info" tamano={28} class="ayuda-paso__icono" />
        <h2 class="ayuda-paso__titulo" data-ayuda-titulo>Un paso, una tarea</h2>
        <p class="ayuda-paso__texto" data-ayuda-texto>
          Cada paso pide solo lo necesario. La categoría se elige entre 4 opciones, no en una lista larga.
        </p>
      </Tarjeta>

      <Tarjeta como="div" class="lado-resumen" data-lado="2" hidden>
        <h2 class="lado__titulo">Resumen del contenido</h2>
        <dl class="cifras">
          <div><dt>Módulos</dt><dd data-cifra="modulos">0</dd></div>
          <div><dt>Clases</dt><dd data-cifra="clases">0</dd></div>
          <div><dt>Videos con subtítulos</dt><dd data-cifra="media">0 de 0</dd></div>
        </dl>
      </Tarjeta>

      <Tarjeta como="div" class="lado-resumen" data-lado="3" hidden>
        <h2 class="lado__titulo">Preguntas</h2>
        <ol class="lista-preguntas" data-lista-preguntas></ol>
      </Tarjeta>
    </aside>
  </div>

  <!-- Cancelar con cambios sin guardar: confirmación (§5.3) y firma de Cancelación (Act. 14) -->
  <Modal id="modal-cancelar" titulo="¿Salir sin guardar?" icono="alerta">
    <p>Perderás los cambios que no guardaste. Si guardaste un borrador antes, ese se conserva.</p>
    <Fragment slot="acciones">
      <BotonMultimodal variante="secundario" modo="toque" data-descartar>Descartar y salir</BotonMultimodal>
      <Boton variante="principal" data-cerrar-modal autofocus>Seguir editando</Boton>
    </Fragment>
  </Modal>

  <template data-plantilla="icono-arrastre"><Icono nombre="arrastre" tamano={20} /></template>
  <template data-plantilla="icono-chevron"><Icono nombre="chevron" tamano={22} /></template>
  <template data-plantilla="icono-alerta"><Icono nombre="alerta" tamano={16} /></template>
  <template data-plantilla="icono-check"><Icono nombre="check" tamano={18} /></template>
  <template data-plantilla="badge-editando"><Badge tono="lila">Editando</Badge></template>
</Admin>

<script>
  import '../../../scripts/crear-curso';
</script>

<style>
  .migas {
    display: flex;
    align-items: center;
    gap: var(--e2);
    color: var(--ink2);
  }
  .migas a {
    color: var(--ink2);
    font-weight: 500;
  }
  .migas :global(.migas__flecha) {
    transform: rotate(-90deg);
  }
  .migas [aria-current] {
    color: var(--ink);
    font-weight: 700;
  }
  .crear__stepper {
    padding: var(--e4) var(--e5);
  }

  .crear {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--e5);
    align-items: start;
  }
  @media (max-width: 1599px) {
    .crear {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }
  .crear__form {
    min-width: 0;
  }
  .crear__tarjeta {
    display: flex;
    flex-direction: column;
    gap: var(--e5);
    overflow: hidden; /* la transición deslizante no se sale de la tarjeta */
    container-type: inline-size;
  }
  /* Si el pie no cabe en una fila, "Paso X de 4" se oculta: ya está sobre el título del paso */
  @container (max-width: 760px) {
    .pie__paso {
      display: none;
    }
  }
  .ceja {
    color: var(--indigo3);
    font-weight: 700;
  }

  /* ─── Pasos ─────────────────────────────────────────────── */
  .paso {
    display: flex;
    flex-direction: column;
    gap: var(--e4); /* 24 px entre grupos */
  }
  .paso[hidden],
  .publicado[hidden] {
    display: none;
  }
  .paso__encabezado {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .paso__encabezado h2 {
    outline: none;
  }
  .fila {
    display: grid;
    gap: var(--e3); /* 16 px entre campos de una fila */
    align-items: start;
  }
  .fila--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fila--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
