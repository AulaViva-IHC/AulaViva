---
// Act. 20 · Escala visual SAM (Self-Assessment Manikin) en flujos críticos. Layout App, sin enlace en el menú.
// Sirve a los dos roles: la prueba cambia de cuenta entre el flujo A (estudiante) y el B (administrador).
//   /actividad-20                 → modo de prueba: código del participante (P1, P2…), "Empezar flujo A / B"
//                                   con la tarea, y los datos de prueba (preparar flujo A, borrar cursos de B)
//   /actividad-20?ver=resultados  → resultados por flujo: tabla, promedios, pasos elegidos y puntos críticos,
//                                   "Copiar resultados" y "Descargar CSV"
// 5 estados de los resultados (?simular=ideal|vacio|cargando|error|parcial, solo desarrollo):
//   ideal → respuestas reales · vacío → "Aún no hay respuestas" + "Ir a la prueba" · cargando → skeleton
//   error → "Reintentar" · parcial → el estado de los datos de prueba no cargó: "Reconectar"
// La tarjeta SAM (TarjetaSam.astro) está en /resultado/[id] (flujo A) y /admin/cursos (flujo B).
// Lógica: src/scripts/actividad-20.ts (sesión SAM en src/scripts/sam.ts). Textos: ramas "a20" y "sam".
import App from '../layouts/App.astro';
import Topbar from '../components/Topbar.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Boton from '../components/Boton.astro';
import BotonMultimodal from '../components/BotonMultimodal.astro';
import Campo from '../components/Campo.astro';
import Badge from '../components/Badge.astro';
import Icono from '../components/Icono.astro';
import Modal from '../components/Modal.astro';
import EstadoVacio from '../components/EstadoVacio.astro';
import EstadoError from '../components/EstadoError.astro';
import EstadoParcial from '../components/EstadoParcial.astro';
import { FLUJOS, PASOS } from '../lib/sam';
import { textosDeRamas, traductor } from '../i18n';

const resultados = Astro.url.searchParams.get('ver') === 'resultados';
const pedido = Astro.url.searchParams.get('simular') ?? '';
const simular = import.meta.env.DEV && ['ideal', 'vacio', 'cargando', 'error', 'parcial'].includes(pedido) ? pedido : '';
const desarrollo = import.meta.env.DEV;
const t = traductor(Astro.locals.idioma, Astro.locals.estres);
const textos = textosDeRamas(Astro.locals.idioma, Astro.locals.estres, 'a20', 'sam');
const titulo = resultados ? t('a20.resultados.titulo') : t('a20.titulo');
const conSimular = (ruta: string) => (simular ? `${ruta}${ruta.includes('?') ? '&' : '?'}simular=${simular}` : ruta);
---

<App titulo={titulo} activo="actividad-20" simular={simular}>
  <Topbar titulo={titulo}>
    <Fragment slot="bajada">{resultados ? t('a20.resultados.bajada') : t('a20.bajada')}</Fragment>
  </Topbar>

  <div class="a20" data-a20 data-vista={resultados ? 'resultados' : 'prueba'} data-desarrollo={desarrollo ? '' : undefined}>
    <p class="aviso aviso--advertencia">
      <Icono nombre="alerta" />
      <span>{t('a20.avisoMemoria')}</span>
    </p>

    {
      !resultados && (
        <>
          <Tarjeta aria-labelledby="a20-participante-titulo">
            <h2 class="h2" id="a20-participante-titulo">{t('a20.participanteTitulo')}</h2>
            <div class="a20__participante">
              <Campo
                id="a20-participante"
                etiqueta={t('a20.participante')}
                ayuda={t('a20.participanteAyuda')}
                autocomplete="off"
                spellcheck="false"
                maxlength={4}
                required
                data-participante
              >
                <span slot="extra" data-sugerido hidden>
                  <Badge tono="sugerido">{t('a20.sugerido')}</Badge>
                </span>
              </Campo>
            </div>
          </Tarjeta>

          <Tarjeta aria-labelledby="a20-flujos-titulo">
            <h2 class="h2" id="a20-flujos-titulo">{t('a20.flujosTitulo')}</h2>
            {!desarrollo && (
              <p class="aviso aviso--info">
                <Icono nombre="info" />
                <span>{t('a20.soloDesarrollo')}</span>
              </p>
            )}
            <div class="a20__flujos">
              {FLUJOS.map((f) => (
                <Tarjeta tono="gris" como="article" class="a20__flujo" aria-labelledby={`a20-flujo-${f}`}>
                  <h3 class="a20__flujo-titulo" id={`a20-flujo-${f}`}>
                    <Icono nombre={f === 'A' ? 'medalla' : 'libro'} tamano={20} />
                    {t(`a20.flujo${f}.titulo`)}
                  </h3>
                  <p class="a20__tarea">{t(`a20.flujo${f}.tarea`)}</p>
                  <p class="pequeno secundario">{t(`a20.flujo${f}.detalle`)}</p>
                  <details class="a20__pasos">
                    <summary>{t('a20.pasosDelFlujo')}</summary>
                    <ol>
                      {PASOS[f].map((p) => (
                        <li>
                          <strong>{p}</strong> {t(`sam.pasos.${p}`)}
                        </li>
                      ))}
                    </ol>
                  </details>
                  <BotonMultimodal
                    variante={f === 'A' ? 'principal' : 'secundario'}
                    modo="completo"
                    textoCargando={t('a20.abriendo')}
                    bloque
                    data-empezar={f}
                  >
                    <Icono nombre="play" tamano={18} />
                    {t(`a20.flujo${f}.boton`)}
                  </BotonMultimodal>
                </Tarjeta>
              ))}
            </div>
            <p class="aviso aviso--error" data-empezar-error hidden>
              <Icono nombre="alerta" />
              <span data-empezar-error-texto />
            </p>
          </Tarjeta>

          <Tarjeta aria-labelledby="a20-datos-titulo">
            <h2 class="h2" id="a20-datos-titulo">{t('a20.datosTitulo')}</h2>
            <p class="secundario">{t('a20.datosTexto')}</p>
            <div class="a20__estado" data-estado-region aria-busy="true">
              <ul class="a20__estado-lista" data-estado-lista>
                <li><span class="skeleton sk-linea" aria-hidden="true" /></li>
                <li><span class="skeleton sk-linea" aria-hidden="true" /></li>
                <li><span class="skeleton sk-linea" aria-hidden="true" /></li>
              </ul>
              <EstadoParcial texto={t('a20.resultados.parcialTexto')} multimodal data-estado-parcial hidden />
            </div>
            <div class="a20__acciones">
              <Boton variante="secundario" data-preparar="flujo-a">
                <Icono nombre="reintentar" tamano={18} />
                {t('a20.prepararA')}
              </Boton>
              <Boton variante="secundario" data-preparar="cursos-b">
                <Icono nombre="cerrar" tamano={18} />
                {t('a20.borrarB')}
              </Boton>
              <a class="enlace a20__ver" href={conSimular('/actividad-20?ver=resultados')}>
                <Icono nombre="grafico" tamano={18} />
                {t('a20.verResultados')}
              </a>
            </div>
          </Tarjeta>

          {['flujo-a', 'cursos-b'].map((que) => (
            <Modal
              id={`modal-${que}`}
              titulo={t(que === 'flujo-a' ? 'a20.prepararTitulo' : 'a20.borrarTitulo')}
              icono="alerta"
            >
              <p>{t(que === 'flujo-a' ? 'a20.prepararTexto' : 'a20.borrarTexto')}</p>
              <p class="aviso aviso--error" data-preparar-error hidden>
                <Icono nombre="alerta" />
                <span>{t('a20.errorPreparar')}</span>
              </p>
              <Fragment slot="acciones">
                <Boton variante="secundario" data-cancelar-preparar>
                  {t('a20.cancelar')}
                </Boton>
                <BotonMultimodal
                  variante="principal"
                  modo="completo"
                  textoCargando={t('a20.preparando')}
                  data-confirmar-preparar={que}
                >
                  {t('a20.confirmar')}
                </BotonMultimodal>
              </Fragment>
            </Modal>
          ))}
        </>
      )
    }

    {
      resultados && (
        <div class="a20__resultados" data-resultados aria-busy="true">
          <EstadoParcial texto={t('a20.resultados.parcialTexto')} multimodal data-estado-parcial hidden />

          <div data-region="contenido">
            <Tarjeta class="a20__barra" aria-label={t('a20.resultados.titulo')}>
              <p class="secundario" data-resumen>
                <span class="skeleton sk-linea" aria-hidden="true" />
              </p>
              <div class="a20__acciones" data-herramientas hidden>
                <BotonMultimodal
                  variante="principal"
                  modo="exito-suave"
                  textoCargando={t('a20.resultados.copiando')}
                  textoExito={t('a20.resultados.copiado')}
                  anuncioExito={t('a20.resultados.copiadoAnuncio')}
                  data-copiar
                >
                  <Icono nombre="portapapeles" tamano={18} />
                  {t('a20.resultados.copiar')}
                </BotonMultimodal>
                <Boton variante="secundario" data-csv>
                  <Icono nombre="descargar" tamano={18} />
                  {t('a20.resultados.csv')}
                </Boton>
                <a class="enlace a20__ver" href={conSimular('/actividad-20')}>
                  <Icono nombre="flecha-izq" tamano={18} />
                  {t('a20.volver')}
                </a>
              </div>
              <div class="a20__copiar-manual" data-copiar-manual hidden>
                <label for="a20-texto" class="pequeno">{t('a20.resultados.copiarManual')}</label>
                <textarea id="a20-texto" rows="10" readonly data-copiar-texto />
              </div>
              <p class="pequeno secundario">{t('a20.resultados.reglas')}</p>
            </Tarjeta>

            <div class="a20__flujos-resultados" data-por-flujo>
              {FLUJOS.map((f) => (
                <Tarjeta aria-labelledby={`a20-res-${f}`} data-flujo-resultados={f}>
                  <h2 class="h2" id={`a20-res-${f}`}>{t(`a20.flujo${f}.titulo`)}</h2>
                  <div class="a20__esqueleto" aria-hidden="true">
                    <span class="skeleton sk-bloque" />
                    <span class="skeleton sk-linea" />
                    <span class="skeleton sk-linea" />
                  </div>
                </Tarjeta>
              ))}
            </div>
          </div>

          <Tarjeta data-region="vacio" hidden>
            <EstadoVacio icono="grafico" titulo={t('a20.resultados.vacioTitulo')} texto={t('a20.resultados.vacioTexto')}>
              <Boton variante="principal" href={conSimular('/actividad-20')}>
                {t('a20.resultados.vacioAccion')}
              </Boton>
            </EstadoVacio>
          </Tarjeta>

          <Tarjeta data-region="error" hidden>
            <EstadoError titulo={t('a20.resultados.errorTitulo')} multimodal />
          </Tarjeta>

          <template data-plantilla="critico">
            <Badge tono="rojo">{t('a20.resultados.critico')}</Badge>
          </template>
        </div>
      )
    }
    <p class="solo-lector" aria-live="polite" data-anuncio></p>
  </div>

  <script type="application/json" id="textos-a20" set:html={JSON.stringify(textos)} />
</App>

<script>
  import '../scripts/actividad-20';
</script>

<style>
  .a20 {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }
  .a20 :global(.boton[hidden]),
  .a20 [hidden] {
    display: none !important;
  }
  .a20 :global(.tarjeta) {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
  }
  .a20 .aviso {
    margin: 0;
  }
  .a20__participante {
    max-width: 320px;
  }
  .a20__flujos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--e4);
  }
  .a20__flujos-resultados {
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }
  .a20__flujo-titulo {
    display: flex;
    align-items: center;
    gap: var(--e2);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 700;
  }
  .a20__tarea {
    font-weight: 600;
  }
  .a20__pasos summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--indigo3);
    cursor: pointer;
  }
  .a20__pasos ol {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    margin: 0;
    padding-left: var(--e4);
    color: var(--ink2);
  }
  .a20__estado-lista {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a20__estado-lista :global(li) {
    display: flex;
    align-items: center;
    gap: var(--e2);
    min-height: 32px;
  }
  .a20__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e3);
  }
  .a20__acciones :global(.boton) {
    min-width: fit-content;
  }
  .a20__ver {
    display: inline-flex;
    align-items: center;
    gap: var(--e2);
    min-height: 44px;
  }
  .a20__copiar-manual {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .a20__copiar-manual textarea {
    width: 100%;
    padding: var(--e3);
    border: 0;
    border-radius: var(--radio-control);
    background: var(--paper);
    font: 0.8125rem/1.25rem ui-monospace, Consolas, monospace;
    color: var(--ink);
  }
  .sk-linea {
    display: block;
    width: min(100%, 360px);
    height: 16px;
  }
  .sk-bloque {
    display: block;
    width: 100%;
    height: 96px;
  }
  .a20__esqueleto {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
  }

  /* ─── Resultados por flujo (los pinta actividad-20.ts) ─────────── */
  .a20 :global(.res__critico-cuerpo) {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }
  .a20 :global(.res__critico-cuerpo ul) {
    display: flex;
    flex-direction: column;
    gap: var(--e1);
    margin: 0;
    padding-left: var(--e4);
  }
  .a20 :global(.res__titulo) {
    font-size: 1.125rem;
    line-height: 1.5rem;
    font-weight: 700;
  }
  .a20 :global(.res__promedios) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e3);
    margin: 0;
  }
  .a20 :global(.res__promedio) {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    padding: var(--e3);
    border-radius: var(--radio-control);
    background: var(--paper);
  }
  .a20 :global(.res__promedio dt) {
    color: var(--ink2);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
    font-weight: 600;
  }
  .a20 :global(.res__promedio dd) {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin: 0;
  }
  .a20 :global(.res__valor) {
    font-size: var(--t-h2);
    line-height: var(--lh-h2);
    font-weight: 800;
    color: var(--ink);
  }
  .a20 :global(.res__promedio--critico) {
    background: var(--red-t);
  }
  .a20 :global(.tabla-scroll) {
    overflow-x: auto;
    border-radius: var(--radio-tarjeta);
  }
  .a20 :global(.tabla-scroll:focus-visible) {
    outline: 4px solid var(--foco);
    outline-offset: 2px;
  }
  .a20 :global(.tabla) {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 var(--e1);
    font-size: var(--t-pequeno);
    line-height: var(--lh-pequeno);
  }
  .a20 :global(.tabla--respuestas) {
    min-width: 860px;
  }
  .a20 :global(.tabla caption) {
    text-align: left;
    font-weight: 700;
    color: var(--ink);
    padding-bottom: var(--e1);
  }
  .a20 :global(.tabla th),
  .a20 :global(.tabla td) {
    padding: var(--e2);
    text-align: left;
    vertical-align: top;
  }
  .a20 :global(.tabla thead th) {
    color: var(--ink2);
    font-weight: 600;
  }
  .a20 :global(.tabla tbody th),
  .a20 :global(.tabla tbody td) {
    background: var(--paper);
  }
  .a20 :global(.tabla tbody tr.fila--critica > *) {
    background: var(--red-t);
  }
  .a20 :global(.tabla tbody > tr > :first-child) {
    border-radius: var(--radio-control) 0 0 var(--radio-control);
  }
  .a20 :global(.tabla tbody > tr > :last-child) {
    border-radius: 0 var(--radio-control) var(--radio-control) 0;
  }
  .a20 :global(.res__barra) {
    display: block;
    width: 100%;
    min-width: 80px;
    height: 8px;
    border-radius: 4px;
    background: var(--white);
    overflow: hidden;
  }
  .a20 :global(.res__barra > span) {
    display: block;
    height: 100%;
    background: var(--indigo3);
  }
  .a20 :global(.res__comentario) {
    max-width: 280px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 599px) {
    .a20 :global(.res__col-barra) {
      display: none;
    }
    .a20 :global(.res__promedios) {
      grid-template-columns: 1fr;
    }
    .a20__participante {
      max-width: none;
    }
    .a20__acciones :global(.boton) {
      width: 100%;
    }
  }
  /* Act. 18 · Alto contraste: regiones con borde; los fondos pastel ya pasan a blanco con los tokens */
  :global(:root[data-contraste='alto']) .a20 :global(.res__promedio),
  :global(:root[data-contraste='alto']) .a20 :global(.tabla tbody th),
  :global(:root[data-contraste='alto']) .a20 :global(.tabla tbody td) {
    border: 2px solid #000;
  }
  :global(:root[data-contraste='alto']) .a20 :global(.res__promedio--critico),
  :global(:root[data-contraste='alto']) .a20 :global(.tabla tbody tr.fila--critica > *) {
    border: 3px solid var(--red);
  }
  :global(:root[data-contraste='alto']) .a20 :global(.res__barra) {
    border: 1px solid #000;
  }
</style>
