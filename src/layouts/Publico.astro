---
// Layout público: <head> común y, opcionalmente, la cabecera con el logo.
// El login no usa cabecera (tiene su propio panel índigo).
// Con `seccion` usa la cabecera pública completa (Cursos · Cómo funciona · Verificar) y el pie.
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/animaciones.css';
import '../styles/contraste.css';
import Logo from '../components/Logo.astro';
import RegionesVivas from '../components/RegionesVivas.astro';
import CabeceraPublica, { type SeccionPublica } from '../components/CabeceraPublica.astro';
import PiePublico from '../components/PiePublico.astro';
import { traductor } from '../i18n';

interface Props {
  titulo: string;
  descripcion?: string;
  cabecera?: boolean;
  /** Cabecera pública completa con esta sección marcada, y pie. */
  seccion?: SeccionPublica;
  /** Estado forzado por ?simular= (solo desarrollo, lo usa /estados). */
  simular?: string;
  /** Act. 17: claves i18n del título y la descripción (se traducen y cambian con el selector). */
  claveTitulo?: string;
  claveDescripcion?: string;
}

const {
  titulo,
  descripcion = 'AulaViva: cursos virtuales con certificación verificable.',
  cabecera = true,
  simular = '',
  seccion,
  claveTitulo,
  claveDescripcion,
} = Astro.props;
const { idioma, estres, contraste } = Astro.locals;
const tr = traductor(idioma, estres);
// Solo las páginas traducidas (con claveTitulo) cambian <html lang>; el resto sigue en español
// y la cabecera y el pie llevan su propio lang.
const tituloFinal = claveTitulo ? tr(claveTitulo) : titulo;
const descripcionFinal = claveDescripcion ? tr(claveDescripcion) : descripcion;
---

<!doctype html>
<html
  lang={claveTitulo ? idioma : 'es'}
  data-idioma={idioma}
  data-i18n-modo={estres ? 'estres' : undefined}
  data-i18n-titulo={claveTitulo}
  data-i18n-descripcion={claveDescripcion}
  data-contraste={contraste ?? undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcionFinal} />
    <meta name="theme-color" content="#1B1750" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{tituloFinal} · AulaViva</title>
    <!-- Act. 18: sin cookie de contraste, la preferencia del sistema (prefers-contrast: more) activa el
         alto contraste antes de pintar; si la cambia con la página abierta, se sigue. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        if (html.dataset.contraste || !window.matchMedia) return;
        var consulta = window.matchMedia('(prefers-contrast: more)');
        var aplicar = function () {
          if (html.dataset.contrasteElegido) return;
          if (consulta.matches) html.dataset.contraste = 'alto';
          else delete html.dataset.contraste;
          document.dispatchEvent(new CustomEvent('contraste:cambio'));
        };
        aplicar();
        if (consulta.addEventListener) consulta.addEventListener('change', aplicar);
      })();
    </script>
  </head>
  <body data-simular={simular || undefined}>
    {seccion && <CabeceraPublica activo={seccion} />}
    {
      cabecera && !seccion && (
        <header class="cabecera">
          <Logo />
          <div class="cabecera__acciones">
            <slot name="cabecera" />
          </div>
        </header>
      )
    }
    <slot />
    {seccion && <PiePublico />}
    <RegionesVivas />
  </body>
</html>

<style>
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    min-height: 72px;
    padding: var(--e3) var(--e5);
    background: var(--white);
  }
  .cabecera__acciones {
    display: flex;
    align-items: center;
    gap: var(--e3);
  }
  @media (max-width: 600px) {
    .cabecera {
      padding: var(--e3);
    }
  }
</style>
